          <div class="section-box-title-group">
            <span class="section-box-icon" aria-hidden="true">&#x1F4CB;</span>
            <h2 class="section-box-title" id="aqTitle">Action Queue (Ranked Payoff)</h2>
          </div>
          <div class="section-box-meta-group">
            <span class="aq-payoff-total summary-status-pill mono" id="aqTotalPayoff" style="color:var(--hz-useful);font-weight:normal;"></span>
          </div>
        </div>
        <div class="aq-list" id="aqList"></div>
      </div>

      <!-- Smart Action Center: Step-by-Step Guided Action -->
      <section class="action-card" id="actionCard">
        <div class="simple-sec-intro"><span class="simple-sec-name">Next best step</span><span class="simple-sec-blurb">The one action that protects this session most right now. Copy it, then paste it into the chat.</span></div>
        <div class="section-box-header">
          <div class="section-box-title-group">
            <span class="section-box-icon" aria-hidden="true">&#x26A1;</span>
            <h2 class="section-box-title">Smart Action Center</h2>
          </div>
          <div class="section-box-meta-group">
            <span class="summary-status-pill mono" id="actionCardStatusPill">Active</span>
          </div>
        </div>
        <div class="action-msg">
          <span class="action-icon" id="actionIcon">&#x2713;</span>
          <div id="actionText">
            <strong>Memory is clean.</strong> Only active files and rules are loaded.
          </div>
        </div>

        <div class="guided-step-box" id="guidedStepBox" style="display:none;">
          <div class="cache-compaction-advisory warm-defer" id="cacheCompactionAdvisory" data-advisory-state="warm-defer">
            Cache is currently warm (95% token cost discount). Defer compaction until work pause to avoid 70s execution stall and complete KV cache invalidation.
          </div>
          <div class="action-rows-stack" id="actionRowsStack">
            <div class="m3-action-row" id="actionRowCheckpoint" hidden>
              <div class="m3-action-content">
                <span class="m3-action-icon dot" id="actionCheckpointDot">&#x25CF;</span>
                <div class="m3-action-text">
                  <span class="m3-action-title" id="actionCheckpointTitle">Update task.md checkpoint before compacting</span>
                  <span class="m3-action-sub mono" id="actionCheckpointSub">currently 1 turn behind</span>
                </div>
                <button type="button" class="mini-btn m3-action-btn" id="btnActionSaveTask" title="Ask Agent to save progress to task.md">Save task.md</button>
              </div>
            </div>

            <!-- Action 1: /compact instruction & 1-click copy button -->
            <div class="m3-action-row" id="actionRowCompact">
              <div class="compact-instruction" id="compactInstruction">
                <span class="m3-action-icon amber" aria-hidden="true">&#x26A1;</span>
                <div class="compact-instruction-main">
                  <span class="compact-instruction-title">Compact conversation history</span>
                  <span class="compact-instruction-sub mono">Type <kbd class="cmd-kbd">/compact</kbd> in the chat box and press <kbd>Enter</kbd></span>
                </div>
                <span class="compact-reclaim mono" id="compactReclaim">reclaims ~0k</span>
                <button type="button" class="mini-btn m3-action-btn mono" id="btnCompactPrimary" title="Copy /compact command to clipboard"><span class="simple-emoji-decor" aria-hidden="true">&#x1F4CB; </span>Copy /compact</button>
              </div>
            </div>

            <div class="m3-action-row" id="actionRowHighLeverage" hidden>
              <div class="m3-action-content">
                <span class="m3-action-icon spark" id="actionHighLeverageIcon">&#x2726;</span>
                <div class="m3-action-text">
                  <span class="m3-action-title" id="actionHighLeverageTitle">Promote 1 unlogged correction to AGENTS.md</span>
                  <span class="m3-action-sub mono" id="actionHighLeverageSub">Primacy zone candidate</span>
                </div>
                <button type="button" class="mini-btn m3-action-btn" id="btnActionHighLeverage" title="Execute high-leverage action">Promote Rule</button>
              </div>
            </div>
          </div>
          <details class="param-compact-details advanced-only" id="parameterizedCompactDetails">
            <summary>Parameterized <code>/compact</code> template</summary>
            <div class="param-compact-box mono" id="parameterizedCompactBox">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px;">
                <span class="param-compact-label">Parameterized Compaction Template (Copy or Type in Chat)</span>
                <button type="button" class="mini-btn m3-action-btn mono" id="btnCopyParameterizedCompact" title="Copy parameterized /compact command to clipboard"><span class="simple-emoji-decor" aria-hidden="true">&#x1F4CB; </span>Copy Template</button>
              </div>
              <div id="parameterizedCompactText">/compact Focus on preserving: 1) Exported symbol signatures and state scales for [active workspace files], 2) Current checklist state in task.md.</div>
            </div>
          </details>
          <div class="baton-pass-row advanced-only" id="batonPassRow">
            <div class="baton-pass-info">
              <strong>Save Handoff &amp; Start Fresh Chat</strong> &middot; Start fresh: writes <code>docs/HANDOFF_&lt;time&gt;.md</code> to paste into a new chat
            </div>
            <button type="button" class="btn-baton-pass" id="btnGenerateHandoff" title="Writes docs/HANDOFF_<timestamp>.md summarizing active AST contracts, test states, and pending task.md tasks">Generate Handoff Markdown</button>
          </div>

          <div class="action-footers-row advanced-only">
            <details class="survive-drawer" id="surviveDrawer">
              <summary>What survives /compact?</summary>
              <div class="survive-grid">
                <div class="survive-col keep">
                  <div class="survive-title">&#x2713; Preserved</div>
                  <ul>
                    <li>AGENTS.md &amp; rules</li>
                    <li>task.md state</li>
                    <li id="surviveRecent">Most recent active turns</li>
                  </ul>
                </div>
                <div class="survive-col drop">
                  <div class="survive-title" id="surviveDropTitle">Compressed</div>
                  <ul id="surviveDropList"></ul>
                </div>
              </div>
            </details>

            <details class="secondary-drawer" id="secondaryDrawer">
              <summary>Other actions (Save, refresh, start fresh) <span class="handoff-dot" id="handoffDot"></span></summary>
              <div class="secondary-buttons">
                <button class="btn-secondary" id="btnCheckpoint" title="Sends a prompt to the agent in this chat to save progress to task.md">&#x1F4AC; Ask Agent: Save task.md</button>
                <button class="btn-secondary" id="btnCondenseAst" title="Condenses stale duplicate file reads into compact declaration signature stubs and collapses resolved stack traces (Prefix-Cache Safe)">&#x2702;&#xFE0F; Condense Stale Reads (Signature Stubs)</button>
                <button class="btn-secondary" id="btnNewChat" title="Opens a fresh chat session with handoff context from this conversation">&#x1F680; Resume in Clean Chat &#x2197;</button>
              </div>
              <div class="handoff-status" id="handoffStatus" hidden></div>
              <div class="handoff-confirm" id="handoffConfirm" hidden>
                <div id="handoffConfirmMsg"></div>
                <div class="handoff-confirm-btns">
                  <button class="mini-btn" id="btnSyncFirst">Sync task.md first</button>
                  <button class="mini-btn muted" id="btnStartAnyway">Start anyway</button>
                </div>
              </div>
            </details>
          </div>
        </div>
      </section>
    </div>
  </details>

