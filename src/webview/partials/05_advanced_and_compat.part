  <!-- =========================================================================
       LIVE EDWARD TUFTE "ADVANCED VIEW" SURFACE (Active when data-view-mode=advanced)
       ========================================================================= -->
  <div id="argonAdvancedSurface" aria-label="Highbeam Advanced Telemetry Workbench">
    <div class="ta-subhud">
      <span id="taSessionLabel">Active Session</span>
      <span>
        5h: <strong id="taSprint5h" style="color:var(--hz-fg);">0%</strong> &middot;
        7d: <strong id="taWeekly7d" style="color:var(--hz-fg);">0%</strong> &middot;
        RAM: <strong id="taHostRam" style="color:var(--hz-fg);">0.0GB</strong>
      </span>
    </div>

    <!-- Zone A: Chrono-Positional Physics -->
    <section class="ts-zone">
      <div class="ts-head">
        <h2 class="ts-overline">Zone A &middot; Chrono-Positional Physics</h2>
        <span id="taDualTtl" class="ts-meta" data-tone="muted">0% hit &middot; 5m KV 00:00</span>
      </div>
      <div class="ts-status-row">
        <div class="ts-status-badge">
          <span id="taStatusDot" class="ts-dot" data-tone="signal"></span>
          <span id="taStatusLabel">Optimal Cache</span>
        </div>
        <div style="font-size:11px;">
          <strong id="taUsedTok">0.0k</strong>
          <span style="color:var(--hz-muted);">(<span id="taSigTok" style="color:var(--hz-useful);">0.0k</span> sig + <span id="taClutterTok" style="color:var(--hz-clutter);">0.0k</span> recl) / <span id="taSafeTok">179.0k</span></span>
        </div>
      </div>
      <div id="taHorizonGrid" class="ta-cell-grid" role="listbox" aria-label="40-cell chronological context window"></div>
      <div id="taCellInspector" class="ta-inspector">
        <span id="taCellLeft">Cell #1 &middot; System Anchor &amp; Rules</span>
        <span id="taCellRight">6.4k / cell &middot; 1.00 recall</span>
      </div>
      <div class="ta-ucurve">
        <div><span style="color:var(--hz-muted);">Primacy (0–30%)</span><br><strong id="taUPrimacy" style="color:var(--hz-useful);">96% recall</strong></div>
        <div><span style="color:var(--hz-muted);">Mid Trough (30–70%)</span><br><strong id="taUTrough" style="color:var(--hz-fg);">62% (0 specs)</strong></div>
        <div><span style="color:var(--hz-muted);">Recency (70–100%)</span><br><strong id="taURecency" style="color:var(--hz-useful);">94% recall</strong></div>
      </div>
      <table class="ta-table" aria-label="Top context token consumers">
        <thead>
          <tr>
            <th style="width:41%;">Consumer Target</th>
            <th style="width:19%;">Pattern</th>
            <th class="num" style="width:13%;">Tokens</th>
            <th class="num" style="width:27%;">Protection</th>
          </tr>
        </thead>
        <tbody id="taConsumersBody">
          <tr><td colspan="4" style="color:var(--hz-muted);">Zero duplicate reads or dead error traces in active window.</td></tr>
        </tbody>
      </table>
    </section>

    <!-- Zone B: Action Queue & Router Governance -->
    <section class="ts-zone">
      <div class="ts-head">
        <h2 class="ts-overline">Zone B &middot; Action Queue &amp; Router Governance</h2>
        <div id="taRouterSwitch" style="display:inline-flex;gap:3px;">
          <button type="button" class="ta-mini-btn" data-ta-mode="off">Off</button>
          <button type="button" class="ta-mini-btn" data-ta-mode="coach" style="border-color:var(--hz-useful);color:var(--hz-useful);">Coach</button>
          <button type="button" class="ta-mini-btn" data-ta-mode="autopilot">Auto-Pilot</button>
        </div>
      </div>
      <div id="taActionQueue" class="ts-guidance-list">
        <div class="ts-guidance-row" data-tone="do">
          <span class="ts-tag">QUEUE</span>
          <span>Nominal queue &middot; 0 orphan PIDs, 0 idle eager MCPs, 0 trough specs</span>
        </div>
      </div>
      <div id="taRouterNote" class="ta-inspector" style="color:var(--hz-fg-secondary);">
        KV Gravity Router ready &middot; Turn-boundary switch buffer armed
      </div>
    </section>

    <!-- Zone C: Turn-0 Baseline & DET-01..32 Guard Log -->
    <section class="ts-zone">
      <div class="ts-head">
        <h2 class="ts-overline">Zone C &middot; Turn-0 Baseline &amp; DET-01..32 Log</h2>
        <span id="taDetBadge" class="ts-meta">32/32 guards armed</span>
      </div>
      <div class="ta-inspector">
        <span id="taBaselineText">Turn-0 Baseline: <strong>0.0k</strong> / 20.0k budget</span>
        <button type="button" id="taBtnShield" class="ta-mini-btn" disabled>Shield: 0 queued</button>
      </div>
      <table class="ta-table" aria-label="DET-01 to DET-32 guard log">
        <thead>
          <tr>
            <th style="width:14%;">Age</th>
            <th style="width:18%;">Guard</th>
            <th style="width:50%;">Intervention</th>
            <th class="num" style="width:18%;">Saved</th>
          </tr>
        </thead>
        <tbody id="taGuardBody">
          <tr><td>now</td><td>DET-01..32</td><td>FTS5 compressor &amp; 3-strike breakers armed</td><td class="num" style="color:var(--hz-muted);">armed</td></tr>
        </tbody>
      </table>
    </section>

    <!-- Zone D: Verified Savings & Memory Surgery -->
    <section class="ts-zone-last">
      <div class="ts-head">
        <h2 class="ts-overline">Zone D &middot; Verified Savings &amp; Memory Surgery</h2>
        <div style="display:inline-flex;gap:4px;">
          <button type="button" id="taBtnCopyCompact" class="ta-mini-btn">Copy /compact</button>
          <button type="button" id="taBtnCopyReceipt" class="ta-mini-btn">Copy Receipt</button>
        </div>
      </div>
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:8px;">
        <div>
          <span id="taKpiTokens" class="ts-kpi-num">0.0k</span>
          <span style="font-size:11px;color:var(--hz-muted);margin-left:4px;">saved</span>
          <span id="taKpiUsd" style="font-size:11.5px;color:var(--hz-useful);margin-left:5px;font-weight:600;">$0.00</span>
        </div>
        <span id="taKpi30d" class="ts-meta">30d: 0.0k ($0.00)</span>
      </div>
      <div class="ta-source-grid">
        <div><span style="color:var(--hz-muted);">Warm KV</span><br><strong id="taSrcCache">+0.0k</strong></div>
        <div><span style="color:var(--hz-muted);">Subagents</span><br><strong id="taSrcSub">+0.0k</strong></div>
        <div><span style="color:var(--hz-muted);">FTS5 CLI</span><br><strong id="taSrcCli">+0.0k</strong></div>
        <div><span style="color:var(--hz-muted);">Guards</span><br><strong id="taSrcGuards">+0.0k</strong></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr auto;gap:6px;">
        <button type="button" id="taBtnSurgeryPrimary" class="ts-cta-btn" data-cta-state="disabled" disabled>
          <span id="taBtnSurgeryLabel">Memory Clean &middot; 0.0k Reclaimable</span>
        </button>
        <button type="button" id="taBtnForceAst" class="ta-mini-btn" style="padding:0 10px;border-color:var(--hz-clutter);color:var(--hz-clutter);" disabled>Fold AST</button>
      </div>
    </section>
  </div>

  <div id="legacyCompatSurface" class="legacy-compat-surface" aria-hidden="true">
  <!-- Active Conversation Context & Model Chip -->
  <div class="active-session-strip" id="activeConversationStrip">
    <div class="active-session-title-wrap">
      <span class="active-session-icon" aria-hidden="true">&#x1F4AC;</span>
      <span class="active-session-label">Active chat</span>
      <span class="active-session-title" id="activeConversationTitle" title="Active Conversation">Active Conversation</span>
    </div>
    <div class="active-session-chips simple-only">
      <span class="amnesia-radar-pill mono" id="simpleAmnesiaPill" hidden title="Memory check: whether your rules and pinned instructions are still inside the AI's working memory.">Memory: 3/3 safe</span>
      <span class="simple-model-chip mono" id="simpleModelChip" title="Active model and reasoning effort. Changing either one mid-session rewrites the prompt cache, so the next turn costs full price.">Model Auto</span>
    </div>
    <button type="button" class="pinned-reset-chip mono" id="btnFollowActiveSession" hidden title="Currently inspecting a pinned conversation. Click to return to live Auto tracking.">Pinned &middot; Follow Active</button>
  </div>

  <!-- Box 1: Context Memory Capacity (Apple Bento Hero in Simple View; Full Box in Advanced View) -->
  <section class="storage-card" id="storageCard">
    <div class="simple-sec-intro"><span class="simple-sec-name">Context health</span><span class="simple-sec-blurb">How full the AI's working memory is. Past the safe limit it starts forgetting your earliest instructions.</span></div>
    <!-- Deterministic Top-Level Verdict Pill -->
    <div class="tufte-verdict-bar mono" id="unifiedVerdictBar" data-verdict-state="NOMINAL">
      <span class="tufte-verdict-text" id="unifiedVerdictText">NOMINAL &middot; Cache warm &middot; 140k to Auto cap</span>
      <span class="tufte-router-hold" id="unifiedRouterHoldNote" hidden></span>
    </div>

    <!-- Option A+ Hero Strip: Runway Left + Apple Watch SVG Cache Ring Right -->
    <div class="simple-hero-row simple-only" id="simpleHeroRow">
      <div class="simple-runway-stack">
        <div class="simple-runway-hero" id="simpleRunwayHero" data-level="good">Healthy</div>
        <div class="simple-runway-sub" id="simpleRunwaySub">0k / 140k safe &middot; 256k cap</div>
      </div>
      <div class="simple-cache-ring-wrap" id="simpleCacheRingWrap" data-warm="false" data-expiring="false" role="img" aria-label="Prompt cache" title="Prompt cache. 'hit' = share of your prompt served from cache at a discount. 'warm' = time left before the cache expires and the next turn is billed at full price.">
        <svg class="simple-cache-ring-svg" viewBox="0 0 40 40" aria-hidden="true">
          <circle class="cache-ring-bg" cx="20" cy="20" r="16"></circle>
          <circle class="cache-ring-fg" id="simpleCacheRingArc" cx="20" cy="20" r="16" stroke-dasharray="100.53" stroke-dashoffset="100.53"></circle>
        </svg>
        <div class="simple-cache-ring-meta">
          <span class="simple-cache-ring-cap" id="simpleCacheRingCap">Prompt cache</span>
          <span class="simple-cache-ring-pct" id="simpleCacheRingPct">Cold</span>
          <span class="simple-cache-ring-ttl" id="simpleCacheRingTtl">0s warm</span>
        </div>
      </div>
    </div>

    <div class="section-box-header">
      <div class="section-box-title-group">
        <span class="section-box-icon" aria-hidden="true">&#x1F4CA;</span>
        <h2 class="section-box-title">Context Memory Capacity</h2>
      </div>
      <div class="section-box-meta-group">
        <span class="prefix-lock-badge mono" id="prefixLockBadge" hidden title="Active warm cache (&gt;50k tokens). Switching models (within or across families) triggers a full uncached cache rebuild; on Claude, changing reasoning effort also re-bills cached chat history (Gemini thinking-level changes keep the cache).">&#x1F512; Warm</span>
        <span class="summary-status-pill mono" id="sessionModelPill" style="font-size:10px;">Auto</span>
        <span class="summary-status-pill mono" id="storageHorizonBadge">Safe Limit: 140k</span>
      </div>
    </div>
    <div class="storage-top">
      <div>
        <span class="used-big mono" id="usedBig">0k</span>
        <span class="used-of mono">/ <span id="usedMaxTok">256k</span> tokens (<span id="usedPct">0%</span>)</span>
        <span class="ceiling-clamp-pill mono" id="ceilingClampPill" hidden></span>
      </div>
      <div class="free-wrap">
        <span class="tufte-model-burn-pill mono" id="tufteModelBurnPill" title="Active Model &amp; Effort Burn Multiplier">Flash 3.8 &middot; Auto</span>
        <span class="tufte-sparkline-group mono" id="tufteTurnSparkline" title="16-turn token velocity sparkline"></span>
        <div class="free-label mono" id="freeLabel">140k safe limit</div>
        <button class="gear-btn" id="btnSettings" type="button" title="Safe limit & reminder settings" aria-expanded="false" aria-controls="settingsPop">&#x2699;</button>
      </div>
    </div>
    <form class="settings-pop" id="settingsPop" hidden>
      <label>Safe limit (tokens)
        <input type="number" id="setSafeLimit" min="20000" max="1048576" step="1000" required>
      </label>
      <label>Remind me at (% of limit)
        <input type="number" id="setReminderPct" min="50" max="99" step="1" required>
      </label>
      <div class="settings-row">
        <button type="submit" class="settings-save">Save</button>
        <button type="button" class="settings-cancel" id="btnSettingsCancel">Cancel</button>
        <span class="settings-msg" id="settingsMsg"></span>
      </div>
    </form>
    <div class="delta-line mono" id="deltaLine" style="display:none;"></div>
    <div class="tufte-delta-accounting mono" id="tufteDeltaAccounting" hidden></div>

    <div class="bar-outer">
      <div class="cascade-line" id="cascadeWatermarkLine" title="50k Cascade Sync Armed: Crossing 50k arms the automatic checkpointer. Completing a task.md item or switching subagents will trigger synchronous auto-compaction.">
        <span class="cascade-tag mono" id="cascadeWatermarkTag">50k Sync</span>
      </div>
      <div class="limit-line border-rose-400/80" id="limitLine" title="Attention Horizon (Safe Limit): Above this mark, earliest instructions start being forgotten">
        <span class="limit-tag text-rose-300" id="limitTag">Safe Limit</span>
      </div>
      <div class="hard-ceiling-line" id="hardCeilingLine" data-source="cortex/utils.GetCheckpointConfig" title="Hard assembly limit (cortex/utils.GetCheckpointConfig)">
        <span class="hard-ceiling-tag mono" id="hardCeilingTag">256k</span>
      </div>
      <div class="bar-track">
        <div class="seg-useful" id="barUseful" style="width: 0%" title="Active Signal"></div>
        <div class="seg-clutter" id="barClutter" style="width: 0%" title="Reclaimable"></div>
        <div class="seg-error" id="barError" style="width: 0%; display: none;" title="Resolved Errors"></div>
      </div>
    </div>

    <div class="breakdown-grid">
      <div class="b-item" title="Rules, task plan, and active files the agent is working with right now">
        <div class="b-head">
          <span class="b-swatch" style="background:var(--hz-useful)"></span>
          <span>Useful Context</span>
        </div>
        <div class="b-val mono" id="valUseful" style="color:var(--hz-useful) !important;">0k (100%)</div>
        <button class="b-sub b-toggle" id="btnSignalToggle" aria-expanded="false" aria-controls="signalDrawer" title="Click to see what is inside Useful Context" style="white-space:nowrap;"><span class="caret">&#x25B6;</span> Rules &amp; work</button>
      </div>

      <div class="b-item" title="Old conversation steps and duplicate file snapshots that can be safely freed">
        <div class="b-head">
          <span class="b-swatch" id="swatchClutter" style="background:var(--hz-clutter)"></span>
          <span id="lblClutter">Reclaimable</span>
        </div>
        <div class="b-val mono" id="valClutter">0k (0%)</div>
        <div class="b-sub" id="subClutter">Can be cleared</div>
        <div class="tufte-col2-cache-strip mono" id="tufteCol2CacheStrip">
          <span id="tufteCol2TtlLabel">Cold &middot; 0s</span>
          <div class="tufte-col2-bar-track"><div class="tufte-col2-bar-fill" id="tufteCol2BarFill" style="width: 0%;"></div></div>
        </div>
      </div>

      <div class="b-item" title="Available memory before the agent begins truncating earliest instructions">
        <div class="b-head">
          <span class="b-swatch" id="swatchFree" style="background:#334155; border: 1.5px solid #64748b"></span>
          <span id="lblFree">Safe Headroom</span>
        </div>
        <div class="b-val mono text-slate-100" id="valFree" style="color:#f1f5f9 !important;">140k left</div>
        <div class="b-sub" id="subFree">Until 140k safe limit</div>
      </div>
    </div>

    <!-- Honest 2-Item Storage Legend & Burn Rate (Simple View Only) -->
    <div class="simple-bar-legend simple-only" id="simpleBarLegend">
      <div class="sbl-pair">
        <span class="sbl-item"><i class="sbl-dot useful"></i><strong id="simpleUsefulVal">0k</strong> Useful</span>
        <span class="sbl-item"><i class="sbl-dot reclaim"></i><strong id="simpleReclaimVal">0k</strong> Reclaimable</span>
      </div>
      <span class="simple-burn-lbl mono" id="simpleBurnRateLbl"></span>
    </div>

    <!-- Inline Top-Offender Cause Attribution (Simple View Only, auto-hides when clean) -->
    <div class="simple-top-offender mono simple-only" id="simpleTopOffenderLine" hidden></div>

    <!-- 1-line Primary Bloat Driver Callout (Advanced View) -->
    <div class="storage-bloat-callout mono" id="storagePrimaryBloatLine">
      <span class="bloat-callout-icon">&#x25CF;</span>
      <strong class="bloat-callout-label">Primary Bloat:</strong>
      <span class="bloat-callout-text" id="storagePrimaryBloatText">Analyzing transcript forensics...</span>
    </div>
  </section>

  <!-- Rank 2B: Top-3 Context Hogs & Swarm Collision (Simple View) / Full Quota Telemetry (Advanced View) -->
  <section class="quota-strip cache-box mono" id="quotaStrip">
    <div class="simple-sec-intro"><span class="simple-sec-name">Waste &amp; prompt cache</span><span class="simple-sec-blurb">Files and old errors wasting memory that you can free, plus when the prompt cache (a discount on re-sent text) expires.</span></div>
    <div class="section-box-header">
      <div class="section-box-title-group">
        <span class="section-box-icon" aria-hidden="true">&#x26A1;</span>
        <h2 class="section-box-title">Prompt Cache &amp; Quota Pacing</h2>
      </div>
      <div class="section-box-meta-group">
        <span class="summary-status-pill mono" id="quotaCacheStatusPill">Cold</span>
      </div>
    </div>

    <details class="simple-hogs-drawer simple-only" id="simpleTopHogsDrawer" data-empty="true">
      <summary class="simple-hogs-summary" id="simpleTopHogsSummary">
        <span id="simpleTopHogsLabel">Clean working set &middot; 0 context hogs</span>
        <span class="mono" id="simpleTopHogsHint"></span>
      </summary>
      <div class="simple-hogs-list" id="simpleTopHogsList"></div>
    </details>

    <div class="cache-efficiency-meter mono" id="cacheEfficiencyMeter">
      <div class="cache-meter-row">
        <span class="cache-meter-hit" id="cacheHitPctDisplay"><strong id="cacheHitPctVal">0%</strong> Cached</span>
        <span class="cache-meter-split" id="cacheTokenSplitDisplay">No active discount</span>
        <span class="cache-meter-countdown ttl-countdown-clock mono cold" id="ttlCountdownClock" title="5-Minute Prompt Cache Window">Expired</span>
        <span class="cache-meter-saved" id="cacheTokensSavedDisplay">+0k saved</span>
      </div>
      <div class="cache-meter-row sprint-metrics-row mono" id="sprintMetricsRow">
        <span class="sprint-metric retention" id="prefixRetentionDisplay" data-grade="n/a" title="Prefix-Cache Retention Index: share of the reusable prompt prefix actually served from warm KV cache on turns 2+ inside the TTL.">Retain &mdash;</span>
        <span class="sprint-metric drift" id="thinkingDriftDisplay" data-drift="n/a" title="Thinking vs. Generation Drift: reasoning tokens / visible output tokens on the latest turn, plus time-to-first-token.">Think &mdash; &middot; TTFT &mdash;</span>
      </div>
      <details class="swarm-topology-drawer mono" id="swarmTopologyDrawer" data-mode="solo" data-collision="false">
        <summary id="swarmTopologySummary" title="Subagent /swarm roster, git worktrees and scope-lock overlaps (DET-20). Parked (waiting) workers cost $0 until messaged.">Solo agent</summary>
        <div class="swarm-topology-body" id="swarmTopologyBody"></div>
      </details>
      <div class="cache-timer-bar-track" title="5-Minute Prompt Cache Timer">
        <div class="cache-timer-bar-fill cold" id="cacheTimerBarFill" style="width: 0%;"></div>
      </div>
      <div class="cache-operational-guide cold" id="cacheOperationalGuide">
        <span class="guide-icon" id="guideIcon">&#x1F513;</span>
        <span class="guide-text" id="guideText"><strong>What to do now:</strong> Cache is cold — great time to run <code>/compact</code>, switch models, or edit rules without losing a discount.</span>
      </div>
    </div>

    <!-- Quota Telemetry Pills (Advanced View) -->
    <div class="quota-pills flex items-center justify-between gap-2 flex-wrap" id="quotaPills">5h Sprint: 0% &middot; 7d: 0% &middot; Cache: 0% hit (300s TTL)</div>
    <div class="physical-metrics-bar mono" id="physicalMetricsBar" style="display:none;">0k / 256k &middot; 0% &middot; Cache Hit: 0% &middot; Waste: 0k &middot; TTL: 300s</div>
    <div class="quota-Forecast" id="quotaForecast" hidden></div>
    <div class="quota-meta-row mono" id="quotaMetaRow" hidden>
      <span id="quotaPoolReset"></span>
      <span class="quota-credits" id="quotaAiCredits" hidden></span>
    </div>
    <div class="overage-guardrail-banner" id="quotaOverageAlert" hidden></div>
    <div class="overage-guardrail-banner warn" id="overageTtlCliffBanner" hidden></div>
    <div class="overage-guardrail-banner danger" id="coldSessionCostGateBanner" hidden></div>
    <div class="overage-guardrail-banner warn" id="prefixMutationDiffBanner" hidden></div>
  </section>

  <!-- Tier 2: Event-Driven Intervention Card Slot -->
  <div class="tier2-intervention-slot" id="tier2InterventionSlot" hidden>
    <div class="tier2-card-body">
      <span class="tier2-card-title" id="tier2CardTitle">Intervention Required</span>
      <span class="tier2-card-sub mono" id="tier2CardSub"></span>
    </div>
    <button type="button" class="mini-btn m3-action-btn" id="btnTier2PrimaryAction"><span class="simple-emoji-decor" aria-hidden="true">&#x1F4CB; </span>Copy Prompt</button>
  </div>

  <!-- Emergency Circuit Breaker & Drift Alerts (Circuit Breaker surfaces in Simple View too) -->
  <div class="overage-guardrail-banner danger" id="detCircuitBreakerAlert" hidden style="margin: 4px 0; padding: 6px 10px;">
    <span class="alert-icon">&#x26A0;</span>
    <span id="detCircuitBreakerMsg">Guardrail Intervention Active</span>
  </div>
  <div class="high-effort-sludge-banner" id="highEffortSludgeBanner" hidden style="margin: 6px 0;"></div>
  <div class="artifact-drift-banner" id="artifactDriftBanner" hidden style="margin: 6px 0;"><span id="artifactDriftText"></span> <button type="button" class="mini-btn" id="btnDriftSaveTask" title="Sends a prompt to the agent in this chat to save progress to task.md (same as Ask Agent: Save task.md)">Save task.md</button></div>

  <!-- Rank 3: GitHub Check-Run Action Slot (Simple View) -->
  <div class="simple-nominal-confirm simple-only" id="simpleNominalConfirm">
    <span class="nominal-left">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6.2"/><path d="M5.4 8.2 7.2 10l3.5-3.8"/></svg>
      <span>Auto-guard healthy</span>
    </span>
    <span class="savings-scope-sub mono" id="simpleNominalSub">0 actions needed</span>
  </div>

  <section class="health-summary-card simple-actionable-card simple-only" id="simpleActionableBox" hidden>
    <div class="health-summary-header section-box-header">
      <div class="health-summary-title-group">
        <span class="health-summary-icon" aria-hidden="true">&#x26A1;</span>
        <h2 class="health-summary-title">Recommended Actions</h2>
      </div>
      <div class="health-summary-meta-group" style="display:inline-flex; align-items:center; gap:8px;">
        <button type="button" id="simpleResetDismissedBtn" class="m3-reset-btn mono" style="display:none;" title="Restore all dismissed recommendations">&#x21BA; Reset (<span id="simpleResetDismissedCount">0</span>)</button>
