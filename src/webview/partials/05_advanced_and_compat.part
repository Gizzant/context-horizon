  </section>

  <!-- Advanced View Workbench: 4 Clean Collapsible Drawers -->
  <details class="adv-accordion hz-adv-drawer advanced-only" id="advAccWindow" data-adv-id="window" open>
    <summary class="adv-accordion-summary">
      <span class="adv-accordion-title">1. Context &amp; Cache Physics (40-Cell Map &amp; Consumers)</span>
      <span class="summary-status-pill mono" id="advWindowSummaryPill">40 cells</span>
    </summary>
    <div class="adv-accordion-body">
      <details class="advanced-drawer" id="chronoTimelineDrawer" data-slot="collapsible" open>
        <summary><span>40-Cell Context Window Map</span><span class="mono" id="cellSizeTag" style="font-size:10px;">6.4k / cell</span></summary>
        <div class="mini-timeline" id="miniTimeline"></div>
        <div class="tufte-horizon-scale scale-ticks mono" id="tufteHorizonScale">
          <span class="tufte-scale-tick" id="tufteScaleTick0" style="left:0%;">0k</span>
          <span class="tufte-scale-tick" id="tufteScaleTick50" style="left:19.5%;transform:translateX(-50%);">50k</span>
          <span class="tufte-scale-tick" id="tufteScaleTickTrough" style="left:36%;transform:translateX(-50%);">Mid-Window (Lowest Recall)</span>
          <span class="tufte-scale-tick tufte-scale-limit" id="tufteScaleLimitLabel" style="left:57.4%;transform:translateX(-50%);">147k&#x26A1; High limit</span>
          <span class="tufte-scale-tick" id="tufteScaleMaxLabel" style="right:0%;">256k</span>
        </div>
        <div class="chrono-glyph-key mono">
          <span>&#x26A1; Subagent call &middot; &#x21C4; Model/Effort shift</span>
          <span>Hover/click cell to inspect</span>
        </div>
        <div class="det17-badge-strip mono" id="det17BadgeStrip" hidden></div>
        <div class="top-risky-cells-list mono advanced-only" id="topRiskyCellsList" hidden></div>
        <div class="mini-inspector mono" id="miniInspector">Hover or click any block above to inspect 6.4k token slice</div>
        <div class="stranded-signal-banner" id="strandedSignalBanner" hidden></div>
        <div class="cell-turn-filter-panel mono" id="cellTurnFilterPanel" hidden></div>
        <div class="subagent-pills mono" id="subagentPills" hidden></div>
      </details>

      <!-- Context Consumers & Remediations -->
      <section class="playbook-card advanced-only" data-slot="accordion">
        <div class="section-box-header playbook-header">
          <div class="section-box-title-group">
            <span class="section-box-icon" aria-hidden="true">&#x1F50D;</span>
            <h2 class="section-box-title playbook-title">Context Consumers &amp; Remediations</h2>
          </div>
          <div class="section-box-meta-group">
            <span class="summary-status-pill mono playbook-sub" id="playbookSub">Context Consumers</span>
          </div>
        </div>
        <div id="playbookList"></div>
      </section>

      <!-- Action Queue Control Surface -->
      <div class="action-queue mono advanced-only" id="actionQueuePanel" hidden>
