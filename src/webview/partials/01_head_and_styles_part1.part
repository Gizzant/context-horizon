<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Highbeam</title>
<link rel="icon" href="data:,">
<script src="/preload.js"></script>
<style>
  :root {
    /* Host IDE Bridge Overrides (Prevents #333 fallback bleed) */
    --background: #090d16;
    --foreground: #f8fafc;
    --muted: #111827;
    --muted-foreground: #94a3b8;
    --border: rgba(255, 255, 255, 0.10);
    --ring: #38bdf8;

    /* Surface Palette (Developer Slate / Zinc) */
    --hz-bg: #090d16;
    --hz-card: #0f1623;
    --hz-card-alt: #161f30;
    --hz-fg: #f8fafc;
    --hz-fg-secondary: #cbd5e1;
    --hz-muted: #94a3b8;         /* WCAG AA 7.1:1 against --hz-bg */
    --hz-text-dim: #828a9a;      /* WCAG AA >= 4.95:1 on #0d0f13 / 5.6:1 on #090d16 */
    --hz-dim: var(--hz-text-dim);
    --hz-border: rgba(255, 255, 255, 0.10);
    --hz-border-subtle: rgba(255, 255, 255, 0.06);

    /* Semantic Telemetry Indicators */
    --hz-useful: #10b981;        /* Green: Active code + rules */
    --hz-cached-history: #8b5cf6;/* Violet: Cached History — 95% Discounted */
    --hz-clutter: #f59e0b;       /* Amber: Reclaimable noise / Cold Bloat */
    --hz-danger: #ef4444;        /* Red: Over limit / errors */
    --hz-free: #1e293b;          /* Dark slate: Free headroom */
    --hz-anchor: #38bdf8;        /* Cyan: Rules & interactive links */
  }

  :root[data-theme="light"],
  [data-theme="light"] {
    --background: #f6f8fa;
    --foreground: #1f2328;
    --muted: #eaeef2;
    --muted-foreground: #57606a;
    --border: rgba(31, 35, 40, 0.14);
    --hz-bg: #f6f8fa;
    --hz-card: #ffffff;
    --hz-card-alt: #eaeef2;
    --hz-fg: #1f2328;
    --hz-fg-secondary: #424a53;
    --hz-muted: #57606a;         /* WCAG AA 5.74:1 against #f6f8fa */
    --hz-text-dim: #57606a;      /* WCAG AA 5.74:1 against #f6f8fa */
    --hz-dim: var(--hz-text-dim);
    --hz-border: rgba(31, 35, 40, 0.14);
    --hz-border-subtle: rgba(31, 35, 40, 0.08);
    --hz-useful: #116329;
    --hz-cached-history: #6639ba;
    --hz-clutter: #7d4e00;
    --hz-danger: #cf222e;
    --hz-free: #eaeef2;
    --hz-anchor: #0550ae;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { background: var(--hz-bg); color: var(--hz-fg); color-scheme: dark; }
  body {
    background: var(--hz-bg) !important;
    color: var(--hz-fg) !important;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 12.5px;
    line-height: 1.45;
    padding: 12px 14px !important;
    user-select: none;
    -webkit-font-smoothing: antialiased;
  }

  .mono,
  .badge,
  .session-select,
  .b-val,
  .diag-impact,
  .group-pill,
  .chronic-badge,
  .retained-badge,
  .handoff-dot,
  .sig-val,
  .base-tok {
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-variant-numeric: tabular-nums;
  }

  /* Strict WCAG Keyboard Focus States (shadcn/ui ring pattern) */
  button:focus-visible,
  select:focus-visible,
  input:focus-visible,
  summary:focus-visible,
  a:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--ring) !important;
    outline-offset: 2px !important;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  .wrap {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* 1. Top Header */
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 8px;
    padding-bottom: 2px;
  }
  .title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hz-useful);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .dot.warn { background: var(--hz-clutter); }
  .dot.danger { background: var(--hz-danger); }

  h1 {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--hz-fg) !important;
    white-space: nowrap;
  }

  .header-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    min-width: 0;
  }

  /* shadcn/ui Tabs Primitive for Simple / Advanced View Mode */
  .shadcn-tabs-list {
    display: inline-flex;
    align-items: center;
    background: var(--hz-card);
    border: 1px solid var(--hz-border);
    border-radius: 6px;
    padding: 2px;
    gap: 2px;
  }
  .shadcn-tab-trigger {
    background: transparent;
    border: none;
    color: var(--hz-muted) !important;
    font-family: inherit;
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .shadcn-tab-trigger:hover {
    color: var(--hz-fg) !important;
  }
  .shadcn-tab-trigger[aria-selected="true"] {
    background: var(--hz-card-alt);
    color: var(--hz-fg) !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  /* In Simple Mode, hide deep diagnostics & 40-cell timeline unless expanded */
  body[data-view-mode="simple"] .advanced-only {
    display: none !important;
  }
  body[data-view-mode="advanced"] .simple-only {
    display: none !important;
  }

  .badge {
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.12);
    color: var(--hz-useful);
    border: 1px solid rgba(16, 185, 129, 0.35);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .badge.warn {
    background: rgba(245, 158, 11, 0.12);
    color: var(--hz-clutter);
    border-color: rgba(245, 158, 11, 0.4);
  }
  .badge.danger {
    background: rgba(239, 68, 68, 0.14);
    color: var(--hz-danger);
    border-color: rgba(239, 68, 68, 0.45);
  }
  .icon-btn {
    background: var(--hz-card-alt);
    border: 1px solid var(--hz-border);
    color: var(--hz-fg) !important;
    height: 24px;
    padding: 0 8px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 11px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--hz-fg) !important;
  }

  /* Active Conversation Read-Only Context Strip & Advanced Session Inspector */
  .active-session-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 3px 2px 6px;
    border-bottom: 1px solid var(--hz-border-subtle);
  }
  .active-session-title-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }
  .active-session-icon {
    font-size: 11.5px;
    line-height: 1;
    flex-shrink: 0;
    opacity: 0.85;
  }
  .active-session-title {
    font-size: 11.5px;
    font-weight: 600;
    color: #e2e8f0 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pinned-reset-chip {
    font-size: 10px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.14);
    color: var(--hz-clutter) !important;
    border: 1px solid rgba(245, 158, 11, 0.4);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pinned-reset-chip:hover {
    background: rgba(245, 158, 11, 0.24);
  }
  .pinned-reset-chip[hidden] {
    display: none !important;
  }
  .adv-session-inspector {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--hz-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .adv-session-inspector-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .adv-session-hint {
    font-size: 10px;
    color: var(--hz-muted) !important;
  }
  .storage-card #storageHorizonBadge {
    display: none !important;
  }
  .session-bar-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
  }
  .session-label {
    font-size: 11px;
    color: var(--hz-muted) !important;
    font-weight: 600;
    white-space: nowrap;
  }
  .session-select {
    flex: 1;
    min-width: 0;
    background: var(--hz-card-alt);
    color: var(--hz-fg) !important;
    border: 1px solid var(--hz-border);
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11.5px;
    font-weight: 500;
    font-family: inherit;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .session-select option {
    background: var(--hz-card);
    color: var(--hz-fg);
  }
  .prefix-lock-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(56, 189, 248, 0.12);
    color: var(--hz-anchor) !important;
    border: 1px solid rgba(56, 189, 248, 0.35);
    white-space: nowrap;
    cursor: help;
    font-variant-numeric: tabular-nums;
  }
  .prefix-lock-badge[hidden] {
    display: none !important;
  }

  /* 2. Storage Bar Card (Tufte High Data-Ink Ratio: Unified Horizontal Band) */
  .storage-card {
    background: var(--hz-card);
    border: 1px solid var(--hz-border);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .storage-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 10px;
    margin-bottom: 6px;
  }
  .used-big {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--hz-fg) !important;
  }
  .used-of {
    font-size: 12px;
    color: var(--hz-muted) !important;
    font-weight: 400;
    margin-left: 4px;
  }
  .free-label {
    font-size: 11.5px;
    color: var(--hz-muted) !important;
  }
  .delta-line {
    font-size: 11px;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--hz-muted) !important;
    align-items: baseline;
    min-width: 0;
  }
  /* Turn-delta row: the file label ellipsizes; the token suffix never clips */
  .delta-line .delta-head { flex-shrink: 0; white-space: pre; }
  .delta-line .delta-src {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 210px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .delta-line .delta-tok { flex-shrink: 0; white-space: pre; }
  .delta-line .delta-other-steps { flex-shrink: 0; white-space: pre; }
  .delta-line.up { color: #cbd5e1 !important; }
  .delta-line.up.big { color: #f59e0b !important; }
  .delta-line.down { color: #10b981 !important; }
  .free-wrap { display: inline-flex; align-items: center; gap: 6px; }
  .gear-btn {
    background: transparent !important;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 4px;
    color: #cbd5e1 !important;
    font-size: 12px;
    line-height: 1;
    padding: 2px 5px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .gear-btn:hover { border-color: #f59e0b; color: #f59e0b !important; }
  .settings-pop {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 10px;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid var(--hz-border);
    background: var(--hz-bg) !important;
    font-size: 11.5px;
    color: var(--hz-fg) !important;
  }
  .settings-pop[hidden] { display: none; }
  .settings-pop label { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: #e2e8f0 !important; }
  .settings-pop input {
    width: 110px;
    padding: 3px 6px;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    background: #1e293b !important;
    color: #f8fafc !important;
    font-family: ui-monospace, Consolas, monospace;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .settings-row { display: flex; align-items: center; gap: 8px; }
  .settings-save, .settings-cancel {
    padding: 4px 12px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid #f59e0b;
  }
  .settings-save { background: #f59e0b !important; color: #090d16 !important; }
  .settings-cancel { background: transparent !important; color: #cbd5e1 !important; border-color: rgba(148, 163, 184, 0.4); }
  .settings-msg { font-size: 10.5px; color: #94a3b8 !important; }
  .settings-msg.err { color: #ef4444 !important; }
  .base-rows { list-style: none; margin: 6px 0 0; padding: 0; font-size: 10.5px; }
  .base-rows[hidden] { display: none; }
  .base-rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 3px 0; border-bottom: 1px solid var(--hz-border-subtle); color: #cbd5e1 !important; }
  .base-rows li:last-child { border-bottom: none; }
  .base-rows .base-src { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
  .base-rows .base-tok { flex: 0 0 auto; color: #f8fafc !important; text-align: right; font-variant-numeric: tabular-nums; }
  .base-rows em { font-style: normal; color: #94a3b8 !important; font-size: 9.5px; }
  .chronic-badge { font-size: 9.5px; padding: 1px 6px; border-radius: 9px; border: 1px solid rgba(148, 163, 184, 0.35); color: #cbd5e1 !important; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .chronic-badge.hot { border-color: rgba(245, 158, 11, 0.6); color: #f59e0b !important; }
  .chip-btn.chronic { border-color: #f59e0b !important; color: #f59e0b !important; font-weight: 700; }
  .tip-dismiss { background: transparent !important; border: none; color: #94a3b8 !important; cursor: pointer; font-size: 11px; padding: 0 2px; }
  .tip-dismiss:hover { color: #f8fafc !important; }
  #sipTipCard a { color: #38bdf8 !important; }

  .bar-outer {
    position: relative;
    height: 18px;
    width: 100%;
    background: var(--hz-free);
    border-radius: 4px;
    margin-top: 18px;           /* reserved lane for the limit tag so it never overlaps the delta line */
    margin-bottom: 18px;        /* reserved lane below the track for the 50k Sync / ceiling tags */
  }
  .bar-track {
    display: flex;
    height: 100%;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    gap: 1px;
  }
  .seg-useful { background: var(--hz-useful); height: 100%; transition: width 0.25s ease; }
  .seg-clutter { background: var(--hz-clutter); height: 100%; transition: width 0.25s ease, background-color 0.25s ease; }
  .seg-clutter.cached-warm { background: var(--hz-cached-history) !important; }
  .seg-clutter.cold-bloat { background: var(--hz-clutter) !important; }
  .seg-error { display: none; width: 0 !important; height: 100%; }

  .ceiling-clamp-pill {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 600;
    padding: 1px 6px;
    margin-left: 4px;
    border-radius: 4px;
    background: rgba(56, 189, 248, 0.10);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: var(--hz-anchor) !important;
    white-space: nowrap;
    vertical-align: middle;
  }
  .ceiling-clamp-pill[hidden] { display: none !important; }

  .cascade-line {
    position: absolute;
    left: 19.5%;
    top: -3px;
    bottom: -3px;
    border-left: 1px dashed rgba(56, 189, 248, 0.75);
    pointer-events: auto;
    cursor: help;
    z-index: 4;
  }
  .cascade-tag {
    /* Anchored BELOW the bar track so it can never collide with the Safe Limit tag above it */
    position: absolute;
    left: 3px;
    top: auto;
    bottom: -14px;
    font-size: 9.5px;
    font-weight: 600;
    color: #7dd3fc;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .hard-ceiling-line {
    position: absolute;
    right: 0;
    top: -3px;
    bottom: -3px;
    border-right: 2px solid rgba(239, 68, 68, 0.75);
    pointer-events: auto;
    cursor: help;
    z-index: 4;
  }
  .hard-ceiling-tag {
    position: absolute;
    right: 2px;
    bottom: -13px;
    font-size: 9px;
    font-weight: 600;
    color: #94a3b8;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .limit-line {
    position: absolute;
    left: 70%;
    top: -3px;
    bottom: -3px;
    border-left: 1px dashed rgba(251, 113, 133, 0.8); /* border-rose-400/80 */
    pointer-events: auto;
    cursor: help;
    z-index: 5;
  }
  .limit-line::before {
    content: '';
    position: absolute;
    left: -2.5px;
    top: -1px;
    width: 4px;
    height: 1px;
    background: rgba(251, 113, 133, 0.8);
  }
  .limit-tag {
    /* Right-aligned ABOVE the bar track, ending at the marker */
    position: absolute;
    left: -4px;
    right: auto;
    transform: translateX(-100%);
    top: -14px;
    font-size: 10px;
    font-weight: 600;
    color: #fda4af; /* text-rose-300 */
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .limit-tag.flip-right {
    left: 4px;
    right: auto;
    transform: none;
  }

  /* Flattened Horizontal Metric Band (No Nested Boxes-Within-Boxes) */
  .breakdown-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--hz-border);
    padding-top: 10px;
  }
  .b-item {
    background: transparent;
    border: none;
    border-right: 1px solid var(--hz-border-subtle);
    border-radius: 0;
    padding: 0 10px;
    min-width: 0;
  }
  .b-item:first-child { padding-left: 0; }
  .b-item:last-child { border-right: none; padding-right: 0; }
  .b-head {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 500;
    color: var(--hz-muted) !important;
    margin-bottom: 2px;
    min-width: 0;
  }
  .b-head > span:not(.b-swatch) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .b-swatch {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .b-val {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--hz-fg) !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }
  .b-val .b-pct-sub {
    font-size: 10px;
    font-weight: 500;
    opacity: 0.88;
    letter-spacing: -0.01em;
  }
  .b-sub {
    font-size: 10.5px;
    color: var(--hz-muted) !important;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 3. Action Center Card */
  .action-card {
    background: var(--hz-card);
    border: 1px solid var(--hz-border);
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--hz-fg) !important;
  }
  .action-card.warn {
    background: #191610 !important;
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--hz-fg) !important;
  }
  .action-card.danger {
    background: #1e1216 !important;
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: var(--hz-fg) !important;
  }
  .action-msg {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--hz-fg) !important;
  }
  .action-msg strong {
    color: #ffffff !important;
  }
  .action-icon {
    font-size: 14px;
    line-height: 1.2;
    flex-shrink: 0;
  }

  /* Compact Guided Action Box - Flattened */
  .guided-step-box {
    background: transparent !important;
    border: none;
    border-radius: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .action-card .action-icon, .action-card .action-msg { color: var(--hz-fg) !important; }
  .action-card.danger .guided-step-box {
    border: none;
  }

  .compact-instruction {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.5;
    border: 1px solid var(--hz-border-subtle);
    border-left: 3px solid #f59e0b;
    background: var(--hz-bg) !important;
    color: var(--hz-fg) !important;
    cursor: default;
    user-select: text;
  }
  .compact-instruction-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .compact-instruction kbd {
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    background: #1e293b !important;
    color: #e2e8f0 !important;
  }
  .compact-instruction kbd.cmd-kbd {
    color: #f59e0b !important;
    border-color: rgba(245, 158, 11, 0.55);
    font-weight: 700;
  }
  .compact-reclaim {
    display: block;
    font-size: 10.5px;
    font-weight: 500;
    color: #f59e0b !important;
    font-variant-numeric: tabular-nums;
  }
  /* While the green DEFER_WARM banner is visible, mute the urgent amber accent so hierarchy doesn't contradict it */
  #guidedStepBox[data-cache-advisory="lean"] .compact-instruction {
      border-color: var(--hz-border, #475569) !important;
      background: transparent !important;
    }
    #guidedStepBox[data-cache-advisory="warm-defer"] .compact-instruction {
    border-left-color: var(--hz-border);
  }

  /* Material 3 Action Rows (Tier 2) */
  .action-rows-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .m3-action-row {
    background: #1e1f20;
    border: 1px solid #3c4043;
    border-radius: 6px;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .m3-action-row:hover {
    background: #282a2c;
  }
  .m3-action-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 10px;
  }
  .m3-action-icon {
    font-size: 13px;
    line-height: 1;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }
  .m3-action-icon.amber {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.12);
  }
  .m3-action-icon.dot {
    font-size: 11px;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
  }
  .m3-action-icon.spark {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
  }
  .m3-action-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .m3-action-title {
    font-size: 11.5px;
    font-weight: 600;
    color: #f8fafc !important;
    line-height: 1.35;
  }
  .m3-action-sub {
    font-size: 10px;
    color: #94a3b8 !important;
    line-height: 1.25;
  }
  .m3-impact-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto !important;
    height: auto !important;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px !important;
    white-space: nowrap;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .m3-impact-badge.amber {
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24 !important;
  }
  .m3-impact-badge.dot {
    width: auto !important;
    height: auto !important;
    border-radius: 4px !important;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #f59e0b !important;
  }
  .m3-impact-badge.spark {
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8 !important;
  }
  .m3-impact-badge.violet {
    background: rgba(139, 92, 246, 0.14);
    border: 1px solid rgba(139, 92, 246, 0.4);
    color: #c4b5fd !important;
  }
  .m3-action-btn {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 3px 8px;
    font-size: 10.5px;
  }
  .m3-reset-btn {
    font-size: 10px;
    line-height: 1;
    color: var(--text-muted, #94a3b8);
    background: transparent;
    border: 1px dashed rgba(148, 163, 184, 0.35);
    border-radius: 4px;
    padding: 2px 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .m3-reset-btn:hover {
    color: #f1f5f9;
    border-color: rgba(148, 163, 184, 0.7);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Collapsible M3 Action Rows */
  details.m3-action-collapsible {
    overflow: hidden;
  }
  summary.m3-action-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 10px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    background: transparent;
  }
  summary.m3-action-summary::-webkit-details-marker {
    display: none;
  }
  summary.m3-action-summary:hover {
    background: rgba(255, 255, 255, 0.035);
  }
  .m3-action-caret {
    display: inline-block;
    font-size: 8.5px;
    color: var(--hz-muted) !important;
    transition: transform 0.15s ease;
    width: 10px;
    flex-shrink: 0;
  }
  details.m3-action-collapsible[open] > summary .m3-action-caret {
    transform: rotate(90deg);
  }
  .m3-action-body {
    padding: 8px 12px 10px 34px;
    border-top: 1px solid #2d3134;
    background: rgba(0, 0, 0, 0.22);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .m3-action-inst {
    font-size: 11px;
    color: #cbd5e1 !important;
    line-height: 1.45;
  }
  .m3-action-inst code, .m3-action-inst kbd {
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 4px;
    border-radius: 3px;
    color: var(--hz-anchor);
    font-family: ui-monospace, "JetBrains Mono", Consolas, monospace;
    font-size: 10.5px;
  }
  .m3-action-inst kbd.cmd-kbd {
    color: #f59e0b !important;
    border: 1px solid rgba(245, 158, 11, 0.55);
    background: #1e293b !important;
    font-weight: 700;
  }
  .m3-action-data-preview {
    font-family: ui-monospace, "JetBrains Mono", Consolas, monospace;
    font-size: 10px;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 5px 8px;
    color: #94a3b8 !important;
    line-height: 1.4;
    overflow-wrap: break-word;
    word-break: normal;
    max-height: 70px;
    overflow-y: auto;
  }
  .m3-action-btn-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  /* Tier 3: Health Summary Card & Simple Actionable Box */
  .health-summary-card {
    background: #1e1f20 !important;
    border: 1px solid #3c4043 !important;
    border-radius: 8px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--hz-fg) !important;
  }
  .health-summary-card[hidden] {
    display: none !important;
  }
  .m3-action-title kbd {
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 11px;
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    background: #1e293b !important;
    color: #e2e8f0 !important;
  }
  .m3-action-title kbd.cmd-kbd {
    color: #f59e0b !important;
    border-color: rgba(245, 158, 11, 0.55);
    font-weight: 700;
  }
  .section-box-header,
  .health-summary-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 1px solid #282a2c;
    padding-bottom: 6px;
    margin-bottom: 8px;
    width: 100%;
  }
  .section-box-title-group,
  .health-summary-title-group {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .section-box-icon,
  .health-summary-icon {
    font-size: 12.5px;
    flex-shrink: 0;
    line-height: 1;
  }
  .section-box-title,
  .health-summary-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #f8fafc !important;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .section-box-meta-group,
  .health-summary-meta-group {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .summary-status-pill {
    font-size: 10px;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.12);
    color: var(--hz-useful) !important;
    white-space: nowrap;
  }
  .summary-status-pill.warn {
    border-color: rgba(245, 158, 11, 0.4);
    background: rgba(245, 158, 11, 0.12);
    color: var(--hz-clutter) !important;
  }
  .summary-status-pill.danger {
    border-color: rgba(239, 68, 68, 0.45);
    background: rgba(239, 68, 68, 0.14);
    color: var(--hz-danger) !important;
  }
  .health-summary-body {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .summary-bullet {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 11px;
    line-height: 1.45;
    color: #cbd5e1 !important;
  }
  .summary-bullet-icon {
    font-size: 9px;
    line-height: 1.6;
    color: var(--hz-useful);
    flex-shrink: 0;
  }
  .summary-bullet-icon.warn { color: #f59e0b; }
  .summary-bullet-icon.danger { color: #ef4444; }
  .summary-bullet-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .summary-bullet-heading {
    color: #f8fafc !important;
    font-weight: 600;
    margin-right: 4px;
  }
  .health-summary-footer {
    border-top: 1px solid #282a2c;
    padding-top: 6px;
    margin-top: 2px;
  }
  .health-summary-extra {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .health-summary-extra[hidden] {
    display: none !important;
  }
  .summary-bullet kbd {
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 11px;
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    background: #1e293b !important;
    color: #e2e8f0 !important;
  }
  .summary-bullet kbd.cmd-kbd {
    color: #f59e0b !important;
    border-color: rgba(245, 158, 11, 0.55);
    font-weight: 700;
  }
  .summary-inline-btn {
    margin-left: 6px;
    vertical-align: middle;
    padding: 1px 6px;
    font-size: 10px;
    border-radius: 4px;
    cursor: pointer;
    background: #282a2c;
    border: 1px solid #3c4043;
    color: #38bdf8 !important;
  }
  .summary-inline-btn:hover {
    background: #333639;
    border-color: rgba(56, 189, 248, 0.4);
    color: #7dd3fc !important;
  }
  .btn-summary-advanced {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    background: #282a2c;
    border: 1px solid #3c4043;
    color: #38bdf8 !important;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .btn-summary-advanced:hover {
    background: #333639;
    border-color: rgba(56, 189, 248, 0.4);
    color: #7dd3fc !important;
  }
  .btn-summary-advanced .arrow-glyph {
    font-size: 13px;
    transition: transform 0.15s ease;
  }
  .btn-summary-advanced:hover .arrow-glyph {
    transform: translateX(2px);
  }

  .param-compact-details > summary {
    cursor: pointer;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--hz-muted) !important;
    user-select: none;
    padding: 2px 0;
  }
  .param-compact-details[open] > summary { margin-bottom: 4px; }
  /* Advanced mode: template is force-opened by applyViewMode(); hide the disclosure chrome */
  body[data-view-mode="advanced"] .param-compact-details > summary { display: none; }

  .param-compact-box {
    padding: 6px 10px;
    border-radius: 5px;
    border: 1px dashed var(--hz-border);
    background: rgba(15, 22, 35, 0.85);
    font-size: 10.5px;
    line-height: 1.45;
    color: var(--hz-fg-secondary) !important;
    user-select: text;
    word-break: break-word;
  }
  .param-compact-label {
    display: block;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--hz-anchor) !important;
    margin-bottom: 2px;
  }
  .cache-compaction-advisory {
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.4;
  }
  .cache-compaction-advisory.warm-defer {
    background: rgba(13, 148, 136, 0.12);
    border: 1px solid rgba(13, 148, 136, 0.4);
    color: #5eead4 !important;
  }
  .cache-compaction-advisory.cold-compact-now {
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid rgba(245, 158, 11, 0.45);
    color: #fde68a !important;
  }
  .artifact-drift-banner {
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.4;
    background: rgba(239, 68, 68, 0.14);
    border: 1px solid rgba(239, 68, 68, 0.45);
    color: #fca5a5 !important;
  }
  .artifact-drift-banner[hidden] { display: none !important; }
  .baton-pass-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 10px;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    background: rgba(56, 189, 248, 0.08);
  }
  .baton-pass-info {
    font-size: 10.5px;
    color: var(--hz-fg-secondary) !important;
    flex: 1 1 180px;
  }
  .baton-pass-info strong {
    color: var(--hz-anchor) !important;
  }
  .btn-baton-pass {
    padding: 5px 11px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid rgba(56, 189, 248, 0.55);
    background: var(--hz-card-alt);
    color: var(--hz-anchor) !important;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-baton-pass:hover {
    background: rgba(56, 189, 248, 0.16);
    border-color: var(--hz-anchor);
  }

  /* Collapsible Secondary Actions */
  .secondary-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .btn-secondary {
    flex: 1;
    min-width: 135px;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--hz-border);
    background: var(--hz-card-alt);
    color: var(--hz-fg) !important;
    text-align: center;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .feedback-toast {
    display: none;
    padding: 7px 10px;
    border-radius: 5px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: var(--hz-fg) !important;
    font-size: 11px;
    line-height: 1.4;
  }

  /* 4. Diagnostic & Brain Playbook Cards (shadcn/ui Accordion / Collapsible) */
  .playbook-card {
    background: var(--hz-card);
    border: 1px solid var(--hz-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .playbook-header {
    padding: 8px 12px;
    border-bottom: 1px solid var(--hz-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .playbook-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--hz-fg) !important;
  }
  .playbook-sub {
    font-size: 10.5px;
    color: var(--hz-muted) !important;
    font-variant-numeric: tabular-nums;
  }
  .diag-item {
    padding: 0;
    border-bottom: 1px solid var(--hz-border-subtle);
    display: flex;
    flex-direction: column;
    color: var(--hz-fg) !important;
  }
  .diag-item:last-child { border-bottom: none; }
  .diag-item.diag-rollup summary.diag-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 12px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    gap: 8px;
    background: transparent;
    color: var(--hz-fg) !important;
    transition: background-color 0.15s ease;
  }
  .diag-item.diag-rollup summary.diag-top::-webkit-details-marker { display: none; }
  .diag-item.diag-rollup summary.diag-top:hover {
    background: rgba(255, 255, 255, 0.035);
  }
  .diag-item.diag-rollup .diag-body {
    padding: 6px 12px 10px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--hz-border-subtle);
    background: rgba(0, 0, 0, 0.18);
  }
  .diag-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    color: var(--hz-fg) !important;
  }
  .diag-name {
    font-size: 11.5px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
    color: var(--hz-fg) !important;
  }
  .diag-caret {
    display: inline-block;
    font-size: 8.5px;
    color: var(--hz-muted) !important;
    transition: transform 0.15s ease;
    width: 10px;
  }
  .diag-item.diag-rollup[open] summary .diag-caret {
    transform: rotate(90deg);
  }
  .diag-impact {
    font-size: 11px;
    font-weight: 600;
    color: var(--hz-clutter);
    white-space: nowrap;
    text-align: right;
    min-width: 44px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .diag-desc {
    font-size: 11px;
    color: var(--hz-muted) !important;
    line-height: 1.45;
  }
  .diag-desc code {
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 4px;
    border-radius: 3px;
    color: var(--hz-anchor);
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 10.5px;
  }
  .diag-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 3px;
  }
  .mini-btn {
    padding: 4px 9px;
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 600;
    cursor: pointer;
    background: var(--hz-card-alt);
    border: 1px solid var(--hz-border);
    color: var(--hz-anchor) !important;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .mini-btn:hover { background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.35); }
  .mini-btn.danger { color: var(--hz-danger) !important; }
  .mini-btn.danger:hover { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.35); }

  .diag-pill {
    font-size: 10px;
    color: var(--hz-muted) !important;
    background: rgba(255, 255, 255, 0.04);
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid var(--hz-border-subtle);
  }

  details.file-drawer summary {
    font-size: 10.5px;
    color: var(--hz-anchor) !important;
    cursor: pointer;
    margin-top: 2px;
  }
  .file-sublist {
    margin-top: 4px;
    padding-left: 10px;
    border-left: 1px solid var(--hz-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .file-subrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    color: var(--hz-muted) !important;
    font-variant-numeric: tabular-nums;
  }

  /* Diagnostic groups */
  .diag-group.reclaim { border-left: 2px solid var(--hz-clutter); }
  .diag-group.spike {
    border-left: 2px dashed var(--hz-muted);
    background: rgba(148, 163, 184, 0.04);
  }
  .diag-group.tips { border-left: 2px solid var(--hz-anchor); }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid var(--hz-border-subtle);
  }
  .group-title { font-size: 11px; font-weight: 600; letter-spacing: 0.01em; color: #cbd5e1 !important; }
  .group-pill {
    font-size: 10px;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 999px;
    border: 1px solid var(--hz-border);
    color: var(--hz-muted) !important;
    white-space: nowrap;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .diag-group.reclaim .group-pill {
    display: none !important;
  }
  .group-meta {
    font-size: 10px;
    font-weight: 500;
    color: var(--hz-muted) !important;
    white-space: nowrap;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .retained-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    color: var(--hz-muted) !important;
    background: rgba(148, 163, 184, 0.10);
    border: 1px solid var(--hz-border);
  }
  .prompt-btn.flash, .btn-secondary.flash {
    color: var(--hz-useful) !important;
    border-color: var(--hz-useful) !important;
  }

  /* 5. Optional Collapsible 40-Block Timeline */
  details.advanced-drawer {
    background: var(--hz-card);
    border: 1px solid var(--hz-border);
    border-radius: 8px;
    padding: 8px 12px;
  }
  details.advanced-drawer summary {
    font-size: 11px;
    color: var(--hz-muted) !important;
    cursor: pointer;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  details.advanced-drawer summary:hover {
    color: var(--hz-fg) !important;
  }
  .mini-timeline {
    display: flex;
    gap: 2px;
    height: 16px;
    margin-top: 10px;
    border-radius: 3px;
    overflow: visible;
  }
  .mini-cell { flex: 1; height: 100%; background: var(--hz-free); position: relative; border-radius: 1px; cursor: crosshair; }
  .mini-cell.effort-shift {
    border-top: 2px solid #f59e0b;
  }
  .effort-shift-badge {
    position: absolute;
    top: -9px;
    right: -2px;
    font-size: 8.5px;
    line-height: 1;
    font-weight: 700;
    color: #fbbf24;
    background: var(--hz-bg);
    border: 1px solid rgba(245, 158, 11, 0.65);
    border-radius: 3px;
    padding: 0 2px;
    pointer-events: none;
    z-index: 3;
  }
  .limit-reason-tip {
    display: inline-block;
    margin-left: 4px;
    font-size: 10px;
    color: var(--hz-anchor);
    cursor: help;
    vertical-align: baseline;
  }
  .high-effort-sludge-banner {
    background: #231518 !important;
    border: 1px solid rgba(245, 158, 11, 0.55);
    border-left: 3px solid #ef4444;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    color: #fde68a !important;
  }
  .high-effort-sludge-banner[hidden] { display: none !important; }
  .mini-inspector { font-size: 10.5px; color: var(--hz-muted) !important; margin-top: 6px; font-variant-numeric: tabular-nums; }
  .timeline-legend {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    font-size: 9.5px;
    color: var(--hz-muted) !important;
    font-variant-numeric: tabular-nums;
  }
