  .footer-meta {
    text-align: center;
    font-size: 10.5px;
    color: var(--hz-muted) !important;
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
    /* ---- Progressive disclosure & guardrails ---- */
    .b-toggle { background: none; border: 0; padding: 0; margin: 0; text-align: left; font: inherit; font-size: 10.5px; cursor: pointer; color: var(--hz-muted) !important; }
    .b-toggle:hover { color: var(--hz-anchor) !important; }
    .b-toggle .caret { display: inline-block; font-size: 8.5px; transition: transform .15s; }
    .b-toggle[aria-expanded="true"] .caret { transform: rotate(90deg); }
    .signal-drawer { margin-top: 10px; border-top: 1px solid var(--hz-border); padding-top: 10px; background: transparent; }
    .signal-drawer[hidden] { display: none; }
    .sig-row + .sig-row { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--hz-border-subtle); }
    .sig-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 11.5px; font-weight: 600; color: var(--hz-fg) !important; }
    .sig-val { color: var(--hz-useful); text-align: right; font-variant-numeric: tabular-nums; }
    .sig-desc { font-size: 10.5px; color: var(--hz-muted) !important; margin-top: 2px; }
    .sig-desc code { font-family: ui-monospace, Consolas, monospace; color: var(--hz-anchor); }

    /* Single footer row under primary compact button */
    .action-footers-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 6px 14px;
      margin-top: 4px;
      padding-top: 8px;
      border-top: 1px solid var(--hz-border-subtle);
    }
    .action-footers-row details {
      flex: 1 1 auto;
      font-size: 11px;
    }
    .action-footers-row details[open] {
      flex: 1 1 100%;
    }
    .action-footers-row details summary {
      cursor: pointer;
      color: var(--hz-anchor) !important;
      font-size: 11px;
      font-weight: 600;
      list-style: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      user-select: none;
    }
    .action-footers-row details summary::-webkit-details-marker { display: none; }
    .action-footers-row details summary::before {
      content: '\25B6';
      display: inline-block;
      font-size: 8px;
      transition: transform 0.15s ease;
    }
    .action-footers-row details[open] summary::before {
      transform: rotate(90deg);
    }
    .action-footers-row details summary:hover {
      color: var(--hz-fg) !important;
    }

    .survive-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; margin-top: 8px; }
  .survive-grid > * { min-width: 0; overflow-wrap: anywhere; }
    .survive-col { border: 1px solid var(--hz-border); border-radius: 6px; padding: 6px 8px; font-size: 11px; }
    .survive-col.keep { background: rgba(16, 185, 129, 0.06); border-color: rgba(16, 185, 129, 0.25); }
    .survive-col.drop { background: rgba(245, 158, 11, 0.06); border-color: rgba(245, 158, 11, 0.25); }
    .survive-title { font-weight: 700; margin-bottom: 3px; }
    .survive-col.keep .survive-title { color: var(--hz-useful); }
    .survive-col.drop .survive-title { color: var(--hz-clutter); }
    .survive-col ul { margin: 0; padding-left: 16px; color: var(--hz-muted) !important; }

    .handoff-dot { font-size: 10.5px; font-weight: 700; margin-left: 4px; }
    .handoff-dot.synced { color: var(--hz-useful); }
    .handoff-dot.stale { color: var(--hz-clutter); }
    .handoff-dot .task-sync-badge { color: inherit; }
    .handoff-status { margin-top: 8px; font-size: 11.5px; font-weight: 600; }
    .handoff-status[hidden], .handoff-confirm[hidden] { display: none; }
    .handoff-status.synced { color: var(--hz-useful); }
    .handoff-status.stale { color: var(--hz-clutter); }
    .btn-secondary.emphasis { border-color: var(--hz-clutter); }
    .handoff-confirm { margin-top: 8px; padding: 8px 10px; border: 1px solid var(--hz-clutter); border-radius: 6px; background: rgba(245, 158, 11, 0.08); font-size: 11.5px; color: var(--hz-fg) !important; }
    .handoff-confirm-btns { display: flex; gap: 8px; margin-top: 6px; }
    .mini-btn.muted { color: var(--hz-muted) !important; }

    /* Diagnostic item alignment & full-line drawers */
    .diag-drawer-full { margin: 0; }
    .diag-drawer-full summary {
      font-size: 11px;
      color: var(--hz-anchor) !important;
      cursor: pointer;
      list-style: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      user-select: none;
    }
    .diag-drawer-full summary::-webkit-details-marker { display: none; }
    .diag-drawer-full summary::before { content: '\25B6'; font-size: 8px; }
    .diag-drawer-full[open] summary::before { content: '\25BC'; }
    .diag-footer-bar, .diag-actions-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 6px;
      padding-bottom: 2px;
    }
    .diag-actions-label {
      font-size: 10.5px;
      font-weight: 600;
      color: var(--hz-muted) !important;
    }
    .diag-actions-buttons {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
    }
    .diag-hint {
      font-size: 10px;
      color: var(--hz-muted) !important;
      user-select: none;
      white-space: nowrap;
      align-self: center;
    }
    .prompt-btn.flash, .btn-secondary.flash, .chip-btn.flash {
      color: var(--hz-useful) !important;
      border-color: var(--hz-useful) !important;
    }
    .file-subrow.rich { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; }
    .file-subrow.rich .fpath { flex: 1 1 140px; min-width: 0; overflow: hidden; text-overflow: ellipsis; text-align: left; color: #cbd5e1 !important; }
    .file-subrow.rich .fmeta { text-align: right; font-variant-numeric: tabular-nums; color: var(--hz-muted) !important; }
    .chip-btn { font: inherit; font-size: 10.5px; padding: 1px 7px; border-radius: 999px; border: 1px solid var(--hz-border); background: transparent; color: var(--hz-muted) !important; cursor: pointer; }
    .chip-btn:hover { color: var(--hz-anchor) !important; border-color: var(--hz-anchor); }
    .chip-btn.noisy { color: var(--hz-clutter) !important; border-color: var(--hz-clutter); }
    .payload-box { margin-top: 6px; padding: 6px 8px; border: 1px solid var(--hz-border); border-radius: 6px; font-size: 11px; color: var(--hz-fg) !important; overflow-wrap: break-word; word-break: normal; }
    .payload-box .payload-kind { color: var(--hz-muted) !important; display: block; margin-bottom: 2px; word-break: normal; overflow-wrap: break-word; }
    .payload-box .chip-btn, .payload-box .mini-btn { margin-top: 6px; }
    .quota-strip {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 5px 8px;
      background: var(--hz-card);
      border: 1px solid var(--hz-border);
      border-radius: 6px;
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      font-size: 10px;
      letter-spacing: -0.01em;
      color: var(--hz-muted) !important;
      font-variant-numeric: tabular-nums;
    }
    .quota-strip[hidden] { display: none !important; }
    .quota-pills {
      display: flex;
      flex: 1 1 100%;
      flex-wrap: wrap;
      gap: 4px 8px;
      align-items: center;
      justify-content: space-between;
    }
    .quota-telemetry {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
      white-space: normal;
      min-width: 0;
      flex: 1 1 auto;
    }
    .quota-Forecast { color: var(--hz-anchor) !important; font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
    .quota-Forecast[hidden] { display: none !important; }
    .quota-warn {
      color: var(--hz-clutter) !important;
      font-weight: 700;
      white-space: nowrap;
      margin-left: auto;
    }
    @keyframes hzTtlPulse {
      0%, 100% { border-color: rgba(245, 158, 11, 0.35); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
      50% { border-color: rgba(245, 158, 11, 0.9); box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.2); }
    }
    .quota-strip.ttl-pulse {
      animation: hzTtlPulse 1.6s ease-in-out infinite;
      border-color: rgba(245, 158, 11, 0.65);
    }
    .ttl-pulse-badge {
      color: var(--hz-clutter) !important;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 4px;
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.4);
      white-space: nowrap;
    }
    .prefix-bust-badge {
      color: var(--hz-clutter) !important;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 4px;
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.4);
      white-space: nowrap;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      display: inline-flex;
      vertical-align: middle;
    }
    .prefix-bust-badge.cold-start-info {
      color: #8ab4f8 !important;
      background: rgba(138, 180, 248, 0.12) !important;
      border: 1px solid rgba(138, 180, 248, 0.35) !important;
    }
    .quota-est {
      color: var(--hz-muted, #94a3b8) !important;
      font-weight: 500;
      font-style: italic;
      cursor: help;
    }
    .quota-meta-row {
      display: flex;
      flex: 1 1 100%;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 4px 8px;
      font-size: 9.5px;
      color: var(--hz-fg-secondary) !important;
      border-top: 1px dashed var(--hz-border-subtle);
      padding-top: 3px;
      margin-top: 2px;
    }
    .quota-meta-row[hidden] { display: none !important; }
    .quota-credits {
      color: var(--hz-anchor) !important;
      font-weight: 600;
      white-space: nowrap;
    }
    .overage-guardrail-banner {
      flex: 1 1 100%;
      margin-top: 3px;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 600;
      line-height: 1.35;
    }
    .overage-guardrail-banner[hidden] { display: none !important; }
    .overage-guardrail-banner.danger {
      background: rgba(239, 68, 68, 0.14);
      border: 1px solid rgba(239, 68, 68, 0.45);
      color: #fca5a5 !important;
    }
    .overage-guardrail-banner.warn {
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.45);
      color: #fde68a !important;
    }
    .bucket-bars { margin-top: 6px; display: flex; flex-direction: column; gap: 4px; }
    .bucket-row { display: grid; grid-template-columns: 72px 1fr 64px; align-items: center; gap: 8px; font-size: 10.5px; color: var(--hz-muted) !important; font-variant-numeric: tabular-nums; }
    .bucket-row > span:first-child { text-align: left; color: #cbd5e1 !important; }
    .bucket-row > span:last-child { text-align: right; font-variant-numeric: tabular-nums; }
    .bucket-track { height: 5px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; }
    .bucket-fill { height: 100%; background: var(--hz-anchor); border-radius: 3px; }
    .subagent-pills { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; }
    .subagent-pill { font-size: 10.5px; padding: 4px 8px; border-radius: 5px; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); color: var(--hz-fg) !important; font-variant-numeric: tabular-nums; }
    .mini-cell { cursor: pointer; position: relative; transition: transform 0.12s ease, opacity 0.12s ease, box-shadow 0.12s ease; }
    .mini-cell.low-attention-trough {
      outline: 1px dashed rgba(245, 158, 11, 0.65);
      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.45);
    }
    .mini-cell.stranded-signal {
      outline: 1.5px solid #f59e0b;
      box-shadow: 0 0 6px rgba(245, 158, 11, 0.45);
    }
    .mini-cell.selected {
      outline: 2px solid #38bdf8;
      transform: translateY(-1px);
      z-index: 3;
    }
    .fracture-marker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      line-height: 1;
      color: #f59e0b !important;
      padding: 0 1px;
      user-select: none;
      cursor: help;
    }
    .stranded-signal-banner {
      margin-top: 6px;
      padding: 6px 8px;
      border-radius: 5px;
      font-size: 10.5px;
      line-height: 1.35;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.45);
      color: #fde68a !important;
    }
    .stranded-signal-banner[hidden] { display: none !important; }
    .cell-turn-filter-panel {
      margin-top: 6px;
      padding: 7px 9px;
      border-radius: 6px;
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid rgba(56, 189, 248, 0.35);
      font-size: 10.5px;
      color: var(--hz-fg) !important;
    }
    .cell-turn-filter-panel[hidden] { display: none !important; }
    .cell-turn-filter-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-weight: 600;
      color: #38bdf8 !important;
      margin-bottom: 4px;
    }
    .host-watchdog-bar {
      display: none;
      flex-direction: column;
      gap: 6px;
      font-size: 10.5px;
      color: var(--hz-muted) !important;
      padding: 6px 12px;
      border-radius: 6px;
      background: var(--hz-card);
      border: 1px solid var(--hz-border-subtle);
      font-variant-numeric: tabular-nums;
    }
    body[data-view-mode="simple"] .host-watchdog-bar:not([data-severity="critical"]):not([data-severity="warning"]),
    body[data-view-mode="simple"] #hostWatchdogBar:not([data-severity="critical"]):not([data-severity="warning"]) {
      display: none !important;
    }
    body[data-view-mode="simple"] #hostWatchdogBar[data-severity="critical"]:not([hidden]),
    body[data-view-mode="simple"] #hostWatchdogBar[data-severity="warning"]:not([hidden]),
    body[data-view-mode="advanced"] .host-watchdog-bar:not([hidden]),
    body[data-view-mode="advanced"] #hostWatchdogBar:not([hidden]) {
      display: flex !important;
    }
    .host-watchdog-body {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
    }
    .host-watchdog-bar.alert {
      border-color: rgba(239, 68, 68, 0.45);
      background: rgba(239, 68, 68, 0.08);
      color: #fca5a5 !important;
    }
    .host-watchdog-bar[hidden] { display: none !important; }
    .model-coach-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 6px 10px;
      padding: 6px 10px;
      background: var(--hz-card);
      border: 1px solid var(--hz-border);
      border-radius: 6px;
      font-size: 11px;
      margin-top: 4px;
    }
    .model-coach-status {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .model-coach-badge {
      font-weight: 600;
      color: var(--hz-fg) !important;
    }
    .model-coach-reset {
      color: var(--hz-muted) !important;
      font-size: 10px;
    }
    .model-coach-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .model-mode-switch {
      display: inline-flex;
      border: 1px solid var(--hz-border);
      border-radius: 4px;
      overflow: hidden;
      background: var(--hz-bg);
    }
    .mode-btn {
      background: transparent;
      border: none;
      color: var(--hz-muted);
      padding: 3px 8px;
      font-size: 10px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s, color 0.15s;
    }
    .mode-btn.active {
      background: var(--hz-card-alt);
      color: var(--hz-anchor) !important;
      font-weight: 600;
    }
    .coach-pill {
      font-size: 10.5px;
      padding: 2px 8px;
      border-radius: 4px;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: var(--hz-anchor) !important;
      cursor: pointer;
      white-space: nowrap;
    }
    .coach-pill[hidden] { display: none !important; }
    .ttl-countdown-clock {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 10.5px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      background: rgba(139, 92, 246, 0.14);
      border: 1px solid rgba(139, 92, 246, 0.40);
      color: #ddd6fe !important;
    }
    .ttl-countdown-clock.ttl-warning-pulse {
      background: rgba(245, 158, 11, 0.16);
      border-color: rgba(245, 158, 11, 0.55);
      color: #fde68a !important;
    }
    .ttl-countdown-clock.ttl-expired-cold-risk {
      background: rgba(239, 68, 68, 0.16);
      border-color: rgba(239, 68, 68, 0.55);
      color: #fecaca !important;
    }

    /* User-Friendly Prompt Cache Box: Visual Countdown Bar & Plain-English Tip */
    [data-view-mode="simple"] .quota-strip .quota-pills,
    [data-view-mode="simple"] .quota-strip .quota-Forecast,
    [data-view-mode="simple"] .quota-strip .quota-meta-row,
    [data-view-mode="simple"] .quota-strip .overage-guardrail-banner {
      display: none !important;
    }
    .cache-efficiency-meter {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 8px 10px;
      margin-top: 2px;
      background: var(--hz-card-alt);
      border: 1px solid var(--hz-border-subtle);
      border-radius: 6px;
      font-size: 11px;
    }
    .cache-meter-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 4px 8px;
      font-variant-numeric: tabular-nums;
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
    }
    .cache-timer-bar-track {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 999px;
      overflow: hidden;
    }
    .cache-timer-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #38bdf8, #34d399);
      border-radius: 999px;
      transition: width 0.35s ease, background 0.25s ease;
    }
    .cache-timer-bar-fill.expiring {
      background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }
    .cache-timer-bar-fill.cold {
      width: 0% !important;
      background: #475569;
    }
    .cache-meter-hit {
      color: #f8fafc !important;
      font-weight: 600;
      font-size: 11.5px;
    }
    .cache-meter-split {
      color: var(--hz-muted) !important;
      font-size: 10.5px;
    }
    .cache-meter-countdown {
      color: #38bdf8 !important;
      font-weight: 600;
      font-size: 11px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.3);
    }
    .cache-meter-countdown.cold {
      color: #94a3b8 !important;
      background: rgba(148, 163, 184, 0.1);
      border-color: rgba(148, 163, 184, 0.25);
    }
    .cache-meter-saved {
      display: none;
    }
    .sprint-metrics-row {
      font-size: 10.5px;
      color: #cbd5e1;
    }
    .sprint-metric {
      padding: 1px 6px;
      border-radius: 4px;
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: rgba(148, 163, 184, 0.08);
      color: #cbd5e1 !important;
      white-space: nowrap;
    }
    .sprint-metric.retention[data-grade="A"] { color: #6ee7b7 !important; border-color: rgba(52, 211, 153, 0.35); }
    .sprint-metric.retention[data-grade="B"] { color: #fcd34d !important; border-color: rgba(251, 191, 36, 0.35); }
    .sprint-metric.retention[data-grade="C"] { color: #fca5a5 !important; border-color: rgba(248, 113, 113, 0.4); }
    .sprint-metric.drift[data-drift="elevated"] { color: #fcd34d !important; border-color: rgba(251, 191, 36, 0.35); }
    .sprint-metric.drift[data-drift="loop_detected"] { color: #fecaca !important; background: rgba(239, 68, 68, 0.16); border-color: rgba(248, 113, 113, 0.55); font-weight: 600; }
.swarm-topology-drawer { margin-top: 4px; font-size: 11px; color: #cbd5e1; }
.swarm-topology-drawer > summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 6px; padding: 1px 6px; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 3px; font-variant-numeric: tabular-nums; }
.swarm-topology-drawer > summary::-webkit-details-marker { display: none; }
.swarm-topology-drawer[data-mode="solo"] > summary { color: #94a3b8; }
.swarm-topology-drawer[data-collision="true"] > summary { color: #fecaca; border-color: rgba(248, 113, 113, 0.55); }
.swarm-topology-body { margin-top: 4px; display: grid; gap: 2px; }
.swarm-topology-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
.swarm-topology-table th { text-align: left; font-weight: 500; color: #94a3b8; border-bottom: 1px solid rgba(148, 163, 184, 0.2); padding: 1px 4px; }
.swarm-topology-table td { padding: 1px 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px; }
.swarm-topology-table td.num { text-align: right; }
.swarm-state[data-state="working"] { color: #6ee7b7; }
.swarm-state[data-state="waiting"] { color: #93c5fd; }
.swarm-state[data-state="stopped"] { color: #fcd34d; }
.swarm-state[data-state="killed"] { color: #64748b; text-decoration: line-through; }
.swarm-topology-note { color: #94a3b8; }
.swarm-topology-note.collision { color: #fecaca; }
    .cache-operational-guide {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      padding: 6px 8px;
      border-radius: 5px;
      font-size: 11px;
      line-height: 1.4;
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      border: 1px solid var(--hz-border-subtle);
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .cache-operational-guide.warm {
      background: rgba(56, 189, 248, 0.08);
      border-color: rgba(56, 189, 248, 0.3);
      color: #bae6fd !important;
    }
    .cache-operational-guide.cold {
      background: rgba(16, 185, 129, 0.08);
      border-color: rgba(16, 185, 129, 0.3);
      color: #a7f3d0 !important;
    }
    .guide-icon {
      flex-shrink: 0;
      font-size: 12px;
    }
    .guide-text {
      flex: 1;
    }

    /* Folded 1-Line Primary Bloat Driver inside .storage-card */
    .storage-bloat-callout {
      display: flex;
      align-items: baseline;
      gap: 6px;
      padding: 6px 0 0 0;
      margin-top: 8px;
      border-top: 1px solid var(--hz-border-subtle);
      font-size: 11px;
      color: var(--hz-muted);
      line-height: 1.4;
    }
    .bloat-callout-icon {
      color: var(--hz-clutter);
      font-size: 8px;
      flex-shrink: 0;
    }
    .bloat-callout-label {
      color: var(--hz-muted) !important;
      font-weight: 600;
      white-space: nowrap;
    }
    .bloat-callout-text {
      color: var(--hz-fg) !important;
      font-variant-numeric: tabular-nums;
    }

    /* Cache-Aware Action Gating Hold Banner */
    .cache-gated-hold-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 5px 9px;
      margin-bottom: 8px;
      border-radius: 5px;
      font-size: 10.5px;
      border: 1px dashed rgba(245, 158, 11, 0.4);
      background: rgba(245, 158, 11, 0.07);
      color: #fde68a !important;
    }
    .cache-gated-hold-banner.active {
      border-color: rgba(56, 189, 248, 0.4);
      background: rgba(56, 189, 248, 0.07);
      color: #bae6fd !important;
    }
    .cache-gated-toggle-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 3px;
      padding: 2px 7px;
      font-size: 10px;
      color: #f8fafc;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      transition: background 0.15s;
    }
    .cache-gated-toggle-btn:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    /* Dedicated Domain Boxes: Coaching & RSI */
    .coaching-box, .rsi-box {
      background: var(--hz-card);
      border: 1px solid var(--hz-border);
      border-radius: 8px;
      padding: 8px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 4px;
    }
    .coaching-box[hidden], .rsi-box[hidden] {
      display: none !important;
    }
    .coaching-guardrails-row, .rsi-health-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 10.5px;
      color: var(--hz-muted) !important;
      padding: 2px 0;
      border-top: 1px solid var(--hz-border-subtle);
      font-variant-numeric: tabular-nums;
    }
    .guardrails-icon, .rsi-icon {
      font-size: 12px;
      flex-shrink: 0;
    }
    .rsi-health-summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 6px;
      color: var(--hz-muted);
    }
    .rsi-health-summary strong {
      color: var(--hz-fg);
    }

    .det17-badge-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 6px;
    }
    .det17-badge-strip[hidden] { display: none !important; }
    .det17-shadow-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 10px;
      font-variant-numeric: tabular-nums;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.40);
      color: #fcd34d !important;
    }
    .subagent-live-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 10.5px;
      font-variant-numeric: tabular-nums;
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.45);
      color: #fde68a !important;
      cursor: pointer;
    }
    .subagent-live-pill[hidden] { display: none !important; }
    .tier2-intervention-slot {
      margin: 6px 0;
      padding: 8px 10px;
      border-radius: 6px;
      background: rgba(15, 23, 42, 0.90);
      border: 1px solid rgba(56, 189, 248, 0.45);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 11px;
    }
    .tier2-intervention-slot.critical {
      border-color: rgba(239, 68, 68, 0.60);
      background: rgba(239, 68, 68, 0.10);
    }
    .tier2-intervention-slot[hidden] { display: none !important; }
    .tier2-card-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
      flex: 1 1 auto;
    }
    .tier2-card-title { font-weight: 700; color: var(--hz-fg) !important; }
    .tier2-card-sub { font-size: 10px; color: var(--hz-muted) !important; }
    .tier3-saved-quota-footer {
      height: auto;
      min-height: 26px;
      max-height: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 6px 8px;
      padding: 6px 10px;
      margin-top: 6px;
      border: 1px solid var(--hz-border);
      background: var(--hz-card);
      border-radius: 6px;
      font-size: 10.5px;
      font-variant-numeric: tabular-nums;
      color: var(--hz-fg-secondary) !important;
    }
    .tier3-receipt-text {
      white-space: normal;
      word-break: break-word;
      flex: 1 1 220px;
    }
    .btn-copy-receipt {
      background: transparent;
      border: 1px solid var(--hz-border);
      color: var(--hz-anchor) !important;
      border-radius: 3px;
      padding: 1px 6px;
      font-size: 9.5px;
      font-weight: 600;
      cursor: pointer;
      flex-shrink: 0;
    }
    .prefix-shield-staged-queue {
      margin-top: 4px;
      padding: 3px 6px;
      background: rgba(245, 158, 11, 0.10);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: 4px;
      font-size: 10px;
      color: var(--hz-clutter) !important;
    }
    .prefix-shield-staged-queue[hidden] { display: none !important; }
    .physical-metrics-bar {
      flex: 1 1 100%;
      font-size: 10px;
      color: var(--hz-fg) !important;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.01em;
    }
    .physical-metrics-bar[hidden] { display: none !important; }
    .top-risky-cells-list {
      margin-top: 6px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 10.5px;
      font-variant-numeric: tabular-nums;
    }
    .top-risky-cells-list[hidden] { display: none !important; }
    .top-risky-cell-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding: 4px 8px;
      border-radius: 5px;
      background: rgba(15, 23, 42, 0.55);
      border: 1px solid var(--hz-border-subtle);
      color: var(--hz-fg) !important;
    }
    .top-risky-cell-row > span {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .top-risky-cell-row > button { flex-shrink: 0; }
    .cross-session-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 10.5px;
      color: var(--hz-muted) !important;
      padding: 5px 10px;
      border-radius: 6px;
      background: var(--hz-card);
      border: 1px solid var(--hz-border-subtle);
      font-variant-numeric: tabular-nums;
    }
    .cross-session-banner[hidden] { display: none !important; }

    /* Action Queue (Zero-Prose Control Surface) */
    .action-queue {
      margin-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 8px 10px;
      border-radius: 6px;
      background: var(--hz-card);
      border: 1px solid #2a2f3a;
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }
    .action-queue[hidden] { display: none !important; }
    .aq-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-weight: 700;
      color: var(--hz-fg) !important;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--hz-border-subtle);
      margin-bottom: 4px;
      font-size: 10.5px;
      letter-spacing: 0.02em;
    }
    .aq-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .aq-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 6px 8px;
      padding: 4px 6px;
      border-radius: 4px;
      background: rgba(15, 23, 42, 0.55);
      border: 1px solid rgba(255, 255, 255, 0.04);
    }
    .aq-btn {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fbbf24 !important;
      font-family: inherit;
      font-size: 10.5px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 4px;
      cursor: pointer;
      text-align: left;
      white-space: nowrap;
      flex-shrink: 0;
      transition: all 0.15s ease;
    }
    .aq-btn:hover {
      background: rgba(245, 158, 11, 0.22);
      border-color: rgba(245, 158, 11, 0.6);
      color: #fef08a !important;
    }
    .aq-btn.copied {
      background: rgba(16, 185, 129, 0.2) !important;
      border-color: rgba(16, 185, 129, 0.6) !important;
      color: #a7f3d0 !important;
    }
    .aq-target {
      color: #cbd5e1 !important;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .aq-payoff {
      color: var(--hz-useful) !important;
      font-size: 10.5px;
      text-align: right;
      white-space: nowrap;
    }
    body[data-view-mode="simple"] .action-card {
      display: none !important;
    }
    body[data-view-mode="simple"] #prefixMutationDiffBanner {
      display: none !important;
    }

    /* Option A+ Hybrid Simple View HUD (Apple Storage + Cache Ring + GitHub Check-Run + Activity Rail) */
    .simple-only { display: none; }
    body[data-view-mode="simple"] .simple-only { display: initial; }
    body[data-view-mode="simple"] .simple-emoji-decor,
    body[data-view-mode="simple"] .active-session-icon,
    body[data-view-mode="simple"] .m3-action-icon,
    body[data-view-mode="simple"] #footerMeta,
    body[data-view-mode="simple"] #cacheTokensSavedDisplay,
    body[data-view-mode="simple"] #statusBadge,
    body[data-view-mode="simple"] .storage-card > .section-box-header,
    body[data-view-mode="simple"] .storage-card > .storage-top,
    body[data-view-mode="simple"] .storage-card > .breakdown-grid,
    body[data-view-mode="simple"] .storage-card > .cascade-line,
    body[data-view-mode="simple"] #cascadeWatermarkLine,
    body[data-view-mode="simple"] #hardCeilingLine,
    body[data-view-mode="simple"] .quota-strip > .section-box-header,
    body[data-view-mode="simple"] .quota-strip > .cache-efficiency-meter > .cache-meter-row,
    body[data-view-mode="simple"] .quota-strip > .cache-efficiency-meter > .cache-timer-bar-track,
    body[data-view-mode="simple"] .simple-actionable-card > .section-box-header,
    body[data-view-mode="simple"] #storagePrimaryBloatLine,
    body[data-view-mode="simple"] #ceilingClampPill,
    body[data-view-mode="simple"] #freeLabel,
    body[data-view-mode="simple"] #tufteTurnSparkline,
    body[data-view-mode="simple"] #btnSettings,
    body[data-view-mode="simple"] #deltaLine,
    body[data-view-mode="simple"] #btnSignalToggle,
    body[data-view-mode="simple"] .b-pct-sub,
    body[data-view-mode="simple"] #tufteCol2CacheStrip,
    body[data-view-mode="simple"] #sprintMetricsRow,
    body[data-view-mode="simple"] #quotaPills,
    body[data-view-mode="simple"] #quotaForecast,
    body[data-view-mode="simple"] #quotaMetaRow,
    body[data-view-mode="simple"] #cacheTokenSplitDisplay,
    body[data-view-mode="simple"] #cacheOperationalGuide,
    body[data-view-mode="simple"] #detCircuitBreakerAlert,
    body[data-view-mode="simple"] #swarmTopologyDrawer:not([data-collision="true"]),
    body[data-view-mode="simple"] #highEffortSludgeBanner,
    body[data-view-mode="simple"] #artifactDriftBanner,
    body[data-view-mode="simple"] #savedQuotaFooterBar,
    body[data-view-mode="simple"] #hostWatchdogBar:not([data-severity="critical"]),
    #sessionHealthSummary {
      display: none !important;
    }

    body[data-view-mode="simple"] {
      min-height: 100vh;
    }
    body[data-view-mode="simple"] .wrap {
      gap: 8px !important;
      padding: 10px 12px 12px !important;
      min-height: calc(100vh - 20px);
    }
    body[data-view-mode="simple"] header {
      padding-bottom: 0 !important;
      border-bottom: none !important;
      flex-wrap: nowrap !important;
      gap: 6px !important;
    }
    body[data-view-mode="simple"] .title-group {
      gap: 6px !important;
      min-width: 0;
    }
    body[data-view-mode="simple"] header h1 {
      font-size: 13px !important;
      font-weight: 600 !important;
      letter-spacing: -0.015em !important;
      text-transform: none !important;
      color: var(--hz-fg) !important;
      white-space: nowrap;
    }
    .amnesia-radar-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 7px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      line-height: 1.3;
      white-space: nowrap;
      border: 1px solid rgba(16, 185, 129, 0.28);
      background: rgba(16, 185, 129, 0.10);
      color: #6ee7b7;
    }
    .amnesia-radar-pill[data-risk="warn"] {
      border-color: rgba(245, 158, 11, 0.38);
      background: rgba(245, 158, 11, 0.12);
      color: #fcd34d;
    }
    .amnesia-radar-pill[data-risk="danger"] {
      border-color: rgba(239, 68, 68, 0.45);
      background: rgba(239, 68, 68, 0.14);
      color: #fca5a5;
    }
    .amnesia-radar-pill[hidden] { display: none !important; }
    body[data-view-mode="simple"] .shadcn-tabs-list {
      border-radius: 999px !important;
      padding: 2px !important;
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid var(--hz-border) !important;
    }
    body[data-view-mode="simple"] .shadcn-tab-trigger {
      border-radius: 999px !important;
      padding: 2px 9px !important;
      font-size: 10.5px !important;
      font-weight: 500 !important;
    }
    body[data-view-mode="simple"] .icon-btn {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 24px !important;
      height: 24px !important;
      padding: 0 !important;
      border-radius: 999px !important;
    }
    body[data-view-mode="simple"] .wrap {
      min-width: 0;
      max-width: 100%;
    }
    body[data-view-mode="simple"] header {
      flex-wrap: nowrap !important;
      gap: 6px !important;
    }
    body[data-view-mode="simple"] .title-group {
      min-width: 0;
      flex: 1 1 auto;
    }
    body[data-view-mode="simple"] header h1 {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    body[data-view-mode="simple"] .header-right {
      flex-wrap: nowrap !important;
      flex-shrink: 0;
    }
    body[data-view-mode="simple"] .active-session-strip {
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding: 0 2px 2px !important;
      min-width: 0;
      max-width: 100%;
    }
    body[data-view-mode="simple"] .active-session-title {
      font-size: 11.5px !important;
      font-weight: 500 !important;
      color: var(--hz-muted) !important;
    }
    .active-session-chips {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      flex-shrink: 0;
      min-width: 0;
    }
    .simple-model-chip {
      display: none;
      font-size: 10px;
      color: var(--hz-muted);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--hz-border);
      border-radius: 999px;
      padding: 1px 7px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    body[data-view-mode="simple"] .simple-model-chip { display: inline-flex; align-items: center; }

    /* Verdict Pill inside Bento Card */
    .tufte-verdict-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 4px 8px;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 10.5px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: #e2e8f0 !important;
      background: rgba(148, 163, 184, 0.10);
      border: 1px solid var(--hz-border);
    }
    body[data-view-mode="simple"] .tufte-verdict-bar {
      margin-bottom: 8px;
      padding: 3px 9px;
      font-family: inherit !important;
      font-size: 10.5px;
      border-radius: 999px;
    }
    body[data-view-mode="advanced"] .tufte-verdict-bar {
      padding: 6px 10px;
      border-radius: 6px;
      background: var(--hz-card);
      border: 1px solid var(--hz-border);
    }
    .tufte-verdict-bar[data-verdict-state="HOLD_COMPACT"] {
      color: #fde68a !important;
      background: rgba(139, 92, 246, 0.14);
      border-color: rgba(139, 92, 246, 0.35);
    }
    .tufte-verdict-bar[data-verdict-state="COMPACT_NOW"],
    .tufte-verdict-bar[data-verdict-state="COMPACT_READY"] {
      color: #fde68a !important;
      background: rgba(245, 158, 11, 0.12);
      border-color: rgba(245, 158, 11, 0.35);
    }
    .tufte-verdict-bar[data-verdict-state="CRITICAL_STOP"],
    .tufte-verdict-bar[data-verdict-state="CIRCUIT_BREAKER"] {
      color: #fecaca !important;
      background: rgba(239, 68, 68, 0.15);
      border-color: rgba(239, 68, 68, 0.42);
    }
    .tufte-verdict-bar[data-verdict-state="NOMINAL"] {
      color: #6ee7b7 !important;
      background: rgba(16, 185, 129, 0.10);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .tufte-router-hold {
      font-size: 10px;
      font-weight: 500;
      color: var(--hz-muted) !important;
    }

    /* Zone 2: Apple Storage + Runway + Watch Cache Ring Bento Card */
    body[data-view-mode="simple"] .storage-card {
      background: #0d1117 !important;
      border: 1px solid rgba(240, 246, 252, 0.10) !important;
      border-radius: 14px !important;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset !important;
      padding: 11px 12px 10px !important;
      margin: 0 !important;
    }
    .simple-hero-row {
      display: none;
    }
    body[data-view-mode="simple"] .simple-hero-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }
    .simple-runway-stack {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .simple-runway-hero {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.12;
      color: var(--hz-fg);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .simple-runway-hero[data-level="bad"] { color: #f87171; }
    .simple-runway-hero[data-level="warn"] { color: #fbbf24; }
    .simple-runway-hero[data-level="good"] { color: #f8fafc; }
    .simple-runway-sub {
      font-size: 11px;
      color: var(--hz-muted);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Inline SVG Apple Watch Cache Ring */
    .simple-cache-ring-wrap {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 4px 8px 4px 5px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(240, 246, 252, 0.09);
      flex-shrink: 0;
    }
    .simple-cache-ring-svg {
      width: 34px;
      height: 34px;
      display: block;
      transform: rotate(-90deg);
      flex-shrink: 0;
    }
    .cache-ring-bg {
      fill: none;
      stroke: rgba(148, 163, 184, 0.18);
      stroke-width: 3.4;
    }
    .cache-ring-fg {
      fill: none;
      stroke: #10b981;
      stroke-width: 3.4;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.35s ease, stroke 0.25s ease;
    }
    .simple-cache-ring-wrap[data-warm="false"] .cache-ring-bg {
      stroke-dasharray: 3 3;
      stroke: rgba(148, 163, 184, 0.25);
    }
    .simple-cache-ring-wrap[data-warm="false"] .cache-ring-fg {
      stroke: transparent;
    }
    .simple-cache-ring-wrap[data-expiring="true"] .cache-ring-fg {
      stroke: #f59e0b;
    }
    .simple-cache-ring-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
      font-variant-numeric: tabular-nums;
    }
    .simple-cache-ring-pct {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--hz-fg);
      white-space: nowrap;
    }
    .simple-cache-ring-ttl {
      font-size: 9.5px;
      color: var(--hz-muted);
      white-space: nowrap;
    }
    /* Direct labels + per-section plain-English blurbs (Simple View) */
    .simple-cache-ring-cap,
    .simple-sec-name {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--hz-muted);
      line-height: 1.15;
      white-space: nowrap;
    }
    .simple-cache-ring-cap { max-width: 92px; overflow: hidden; text-overflow: ellipsis; }
    .simple-sec-intro { display: none; }
    /* Brand bar: wordmark left, logo right; Simple/Advanced + reload live in the controls row below */
    .brand-wordmark { height: 26px; width: auto; max-width: calc(100% - 22px); object-fit: contain; display: block; flex-shrink: 1; }
    [data-theme="light"] .brand-wordmark { filter: invert(1) brightness(0.14); }
    .brand-logo { width: 44px; height: 44px; border-radius: 11px; flex-shrink: 0; display: block; box-shadow: 0 0 0 1px rgba(240, 246, 252, 0.14); }
    [data-theme="light"] .brand-logo { box-shadow: 0 0 0 1px rgba(31, 35, 40, 0.18); }
    .header-controls { display: flex; align-items: center; min-width: 0; }
    .header-controls .header-right { flex: 1 1 auto; }
    body[data-view-mode="simple"] .header-controls .header-right { flex-wrap: nowrap !important; width: 100%; }
    body[data-view-mode="simple"] .header-controls .shadcn-tabs-list { flex: 1 1 auto; }
    body[data-view-mode="simple"] .header-controls .shadcn-tab-trigger { flex: 1 1 0; text-align: center; }
    .wrap > header h1,
    body[data-view-mode="simple"] .wrap > header h1 {
      position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important;
    }
    .wrap > header .dot { width: 11px; height: 11px; flex-shrink: 0; }
    /* Section headings: slightly larger + bright (Simple View) */
    body[data-view-mode="simple"] .simple-sec-name,
    body[data-view-mode="simple"] .fr-main-title,
    body[data-view-mode="simple"] .fr-title {
      font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--hz-fg); line-height: 1.2;
    }
    @media (max-width: 380px) {
      .brand-wordmark { height: 23px; }
      .brand-logo { width: 38px; height: 38px; border-radius: 10px; }
    }
    body[data-view-mode="simple"] .active-session-strip { flex-wrap: wrap; row-gap: 5px; }
    body[data-view-mode="simple"] .active-session-strip .active-session-title-wrap { flex: 1 1 100%; min-width: 0; display: flex; align-items: baseline; gap: 7px; }
    .active-session-label { font-size: 10px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--hz-muted); white-space: nowrap; flex-shrink: 0; }
    body[data-view-mode="simple"] .active-session-strip .active-session-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    body[data-view-mode="simple"] .active-session-strip .active-session-chips { flex: 1 1 100%; display: flex; flex-wrap: nowrap; align-items: flex-start; justify-content: space-between; gap: 6px; min-width: 0; max-width: 100%; }
    body[data-view-mode="simple"] .active-session-strip .amnesia-radar-pill,
    body[data-view-mode="simple"] .active-session-strip .simple-model-chip { box-sizing: border-box; height: 20px; padding: 0 8px; line-height: 18px; margin: 0; align-items: center; }
    body[data-view-mode="simple"] .active-session-strip .simple-model-chip {
      display: inline-block; min-width: 0; max-width: 100%; flex: 0 1 auto; margin-left: auto;
      overflow: hidden; text-overflow: ellipsis; text-align: right;
    }
    body[data-view-mode="simple"] .simple-sec-intro {
      display: flex;
      flex-direction: column;
      gap: 1px;
      margin: 0 0 6px 0;
      min-width: 0;
    }
    .simple-sec-blurb {
      font-size: 10px;
      line-height: 1.35;
      color: var(--hz-muted);
      white-space: normal;
      overflow-wrap: anywhere;
    }
    @media (max-height: 580px) {
      body[data-view-mode="simple"] .simple-sec-intro .simple-sec-blurb { display: none; }
    }

    /* Honest 2-Segment Apple Bar */
    body[data-view-mode="simple"] .bar-outer {
      height: 10px !important;
      margin: 6px 0 8px 0 !important;
      padding-top: 0 !important;
    }
    body[data-view-mode="simple"] .bar-track {
      height: 10px !important;
      border-radius: 999px !important;
      background: rgba(148, 163, 184, 0.14) !important;
      overflow: hidden;
    }
    body[data-view-mode="simple"] .seg-useful {
      background: #10b981 !important;
    }
    body[data-view-mode="simple"] .seg-clutter,
    body[data-view-mode="simple"] .seg-clutter.cached-warm,
    body[data-view-mode="simple"] .seg-clutter.cold-bloat {
      background: #f59e0b !important;
    }
    body[data-view-mode="simple"] .storage-card[data-crisis="true"] .seg-clutter {
      background: #ef4444 !important;
    }
    body[data-view-mode="simple"] .limit-line {
      height: 16px !important;
      top: -3px !important;
      border-left-width: 1.5px !important;
      border-color: rgba(248, 250, 252, 0.72) !important;
    }
    body[data-view-mode="simple"] .limit-tag {
      display: none !important;
    }
    .simple-bar-legend {
      display: none;
    }
    body[data-view-mode="simple"] .simple-bar-legend {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 4px 10px;
      font-size: 11px;
      color: var(--hz-fg-secondary);
      font-variant-numeric: tabular-nums;
      margin-top: 2px;
    }
    .sbl-pair {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .sbl-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }
    .sbl-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      display: inline-block;
      flex-shrink: 0;
    }
    .sbl-dot.useful { background: #10b981; }
    .sbl-dot.reclaim { background: #f59e0b; }
    .simple-burn-lbl {
      font-size: 10px;
      color: var(--hz-muted);
      white-space: nowrap;
    }

    /* Hidden test-compat sync element keeps breakdown texts accurate without visual redundancy */
    .tufte-delta-accounting {
      display: block;
      width: 100%;
      font-size: 10px;
      color: var(--hz-muted) !important;
      margin-top: 1px;
      font-variant-numeric: tabular-nums;
    }
    .tufte-horizon-scale {
      display: block;
      position: relative;
      width: 100%;
      height: 14px;
      font-size: 9.5px;
      color: var(--hz-muted) !important;
      margin-top: 4px;
      font-variant-numeric: tabular-nums;
    }
    body[data-view-mode="simple"] .tufte-horizon-scale { display: none !important; }
    .tufte-scale-tick { position: absolute; top: 0; white-space: nowrap; }
    .tufte-scale-limit { color: #fda4af !important; font-weight: 600; }
    .tufte-col2-cache-strip {
      display: none;
      flex-direction: column;
      gap: 3px;
      margin-top: 3px;
      font-size: 10px;
      color: var(--hz-muted) !important;
    }
    .tufte-col2-bar-track {
      width: 100%;
      height: 4px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 999px;
      overflow: hidden;
    }
    .tufte-col2-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #38bdf8, #34d399);
      border-radius: 999px;
      transition: width 0.3s ease;
    }

    body[data-view-mode="simple"] .storage-card,
    body[data-view-mode="simple"] .simple-actionable-card,
    body[data-view-mode="simple"] .flight-recorder,
    body[data-view-mode="simple"] .fr-zones-body,
    body[data-view-mode="simple"] .fr-zone,
    body[data-view-mode="simple"] .m3-action-summary,
    body[data-view-mode="simple"] .m3-action-text {
      min-width: 0;
      max-width: 100%;
    }
    body[data-view-mode="simple"] .storage-card,
    body[data-view-mode="simple"] .simple-actionable-card,
    body[data-view-mode="simple"] .flight-recorder {
      overflow: hidden;
    }
    body[data-view-mode="simple"] .simple-top-offender {
      display: flex;
      flex-wrap: nowrap;
      align-items: baseline;
      gap: 4px;
      margin-top: 7px;
      padding-top: 6px;
      border-top: 1px dashed rgba(148, 163, 184, 0.16);
      font-size: 11px;
      line-height: 1.3;
      color: var(--hz-fg-secondary) !important;
      font-variant-numeric: tabular-nums;
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
    }
    .simple-top-offender[hidden] { display: none !important; }
    .simple-top-offender .offender-kicker { color: #fbbf24 !important; font-weight: 600; flex-shrink: 0; }
    .simple-offender-files {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .simple-offender-err {
      flex: 0 0 auto;
      margin-left: 2px;
      color: #fca5a5;
      font-weight: 600;
      white-space: nowrap;
    }

    /* #quotaStrip in Simple View: stays display:block, hosts Surgical Top-3 Hogs + Swarm Collision */
    body[data-view-mode="simple"] .quota-strip {
      display: block !important;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
    }
    body[data-view-mode="simple"] .cache-efficiency-meter {
      gap: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
      border: none !important;
    }
    .simple-hogs-drawer {
      display: none;
    }
    body[data-view-mode="simple"] .simple-hogs-drawer {
      display: block;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(240, 246, 252, 0.08);
      border-radius: 10px;
      padding: 5px 10px;
    }
    .simple-hogs-summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 11px;
      color: var(--hz-fg-secondary);
      cursor: pointer;
      user-select: none;
    }
    .simple-hogs-summary::-webkit-details-marker { display: none; }
    .simple-hogs-drawer[data-empty="true"] .simple-hogs-summary {
      cursor: default;
      color: var(--hz-muted);
    }
    .simple-hogs-list {
      margin-top: 6px;
      padding-top: 6px;
      border-top: 1px dashed rgba(148, 163, 184, 0.16);
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .simple-hog-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 10.5px;
    }
    .simple-hog-info {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .simple-hog-name {
      color: var(--hz-fg);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .simple-hog-meta {
      color: var(--hz-muted);
      flex-shrink: 0;
      font-variant-numeric: tabular-nums;
    }
    .simple-hog-btn {
      padding: 2px 7px;
      font-size: 10px;
      border-radius: 6px;
      border: 1px solid rgba(56, 189, 248, 0.35);
      background: rgba(56, 189, 248, 0.10);
      color: #7dd3fc;
      cursor: pointer;
      flex-shrink: 0;
      font-weight: 600;
    }
    .simple-hog-btn.ignore {
      border-color: rgba(245, 158, 11, 0.40);
      background: rgba(245, 158, 11, 0.10);
      color: #fcd34d;
    }

    /* Zone 3: GitHub Check-Run Action Slot */
    body[data-view-mode="simple"] .simple-nominal-confirm {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 11px;
      border-radius: 12px;
      background: rgba(16, 185, 129, 0.07);
      border: 1px solid rgba(16, 185, 129, 0.24);
      font-size: 11px;
      color: #6ee7b7 !important;
      font-family: inherit !important;
    }
    .simple-nominal-confirm[hidden] { display: none !important; }
    .nominal-left {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 600;
      min-width: 0;
    }

    body[data-view-mode="simple"] .simple-actionable-card:not([hidden]) {
      background: #0d1117 !important;
      border: 1px solid rgba(240, 246, 252, 0.12) !important;
      border-left: 3px solid #f59e0b !important;
      border-radius: 12px !important;
      padding: 8px 10px !important;
      margin: 0 !important;
      box-shadow: none !important;
    }
    body[data-view-mode="simple"] .simple-actionable-card[data-crisis="true"]:not([hidden]) {
      border-color: rgba(239, 68, 68, 0.38) !important;
      border-left-color: #ef4444 !important;
      background: rgba(239, 68, 68, 0.06) !important;
    }
    body[data-view-mode="simple"] .simple-actionable-card[data-hold="true"]:not([hidden]) {
      border-color: rgba(139, 92, 246, 0.34) !important;
      border-left-color: #8b5cf6 !important;
      background: rgba(139, 92, 246, 0.06) !important;
    }
    body[data-view-mode="simple"] .cache-gated-hold-banner {
      background: transparent !important;
      border: none !important;
      padding: 2px 0 !important;
      font-size: 11px !important;
      line-height: 1.3 !important;
      margin-bottom: 4px !important;
      color: #e9d5ff !important;
      font-family: inherit !important;
    }
    body[data-view-mode="simple"] .compact-instruction-adv {
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      font-size: 10px !important;
      color: var(--hz-muted) !important;
    }
    body[data-view-mode="simple"] .m3-action-row {
      background: transparent !important;
      border: none !important;
      border-left: none !important;
      border-radius: 0 !important;
      border-bottom: 1px dashed rgba(148, 163, 184, 0.14) !important;
      padding: 2px 0 !important;
    }
    body[data-view-mode="simple"] .m3-action-row:last-child { border-bottom: none !important; }
    body[data-view-mode="simple"] .m3-action-title {
      font-size: 11.5px !important;
      font-weight: 600 !important;
      line-height: 1.25 !important;
    }
    body[data-view-mode="simple"] .m3-action-caret {
      display: inline-block !important;
      font-size: 8.5px;
      color: #94a3b8 !important;
      width: 8px;
      margin-right: 1px;
    }
    body[data-view-mode="simple"] .m3-action-summary { padding: 2px 0 !important; gap: 6px !important; cursor: pointer !important; }
    body[data-view-mode="simple"] .m3-action-btn-row { margin-top: 0 !important; flex-shrink: 0; }
    body[data-view-mode="simple"] #btnSimpleCopyCompact {
      background: #1f6feb !important;
      border-color: rgba(56, 139, 253, 0.6) !important;
      color: #ffffff !important;
      font-weight: 600 !important;
      border-radius: 8px !important;
      padding: 4px 10px !important;
    }
    body[data-view-mode="simple"] .simple-actionable-card[data-crisis="true"] #btnSimpleCopyCompact {
      background: #da3633 !important;
      border-color: rgba(248, 81, 73, 0.7) !important;
    }

    .m3-more-actions-drawer { margin-top: 4px; border-top: 1px dashed rgba(148, 163, 184, 0.16); padding-top: 4px; }
    .m3-more-actions-summary {
      list-style: none;
      cursor: pointer;
      font-size: 10px;
      font-weight: 600;
      color: var(--hz-anchor) !important;
      padding: 1px 0;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 4px;
      user-select: none;
    }
    .m3-more-actions-summary::-webkit-details-marker { display: none; }
    .m3-more-actions-summary::before { content: '\25B8  Show '; color: var(--hz-muted); }
    .m3-more-actions-drawer[open] > .m3-more-actions-summary::before { content: '\25BE  Hide '; }
    .m3-more-actions-body { display: flex; flex-direction: column; gap: 4px; margin-top: 4px; }
