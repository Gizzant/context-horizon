<body data-view-mode="simple" data-flight-mode="coach" data-auto-state="na">

<div class="wrap">
  <!-- 1. Header -->
  <header>
    <div class="title-group">
      <div class="dot" id="statusDot"></div>
      <img class="brand-wordmark" src="data:image/png;base64," width="161" height="26" alt="Highbeam" decoding="async">
      <h1>Highbeam</h1>
    </div>
    <img class="brand-logo" src="data:image/png;base64," width="28" height="28" alt="" aria-hidden="true" decoding="async">
  </header>
  <div class="header-controls">
    <div class="header-right">
      <span class="badge mono advanced-only" id="workloadModeBadge">[Mode: Read-Heavy Audit]</span>
      <span class="badge" id="statusBadge">Healthy</span>
      <span class="badge warn advanced-only" id="confidenceBadge" hidden style="display:none;">Degraded</span>
      <div class="shadcn-tabs-list" role="group" aria-label="Advanced view" data-slot="tabs-list">
        <button type="button" class="shadcn-tab-trigger" id="tabAdvanced" data-view-tab="advanced" aria-pressed="false" title="Open the full diagnostic & timeline view">Advanced</button>
      </div>
      <button type="button" class="icon-btn" id="btnHeaderSettings" title="Settings" aria-label="Settings" aria-haspopup="dialog" aria-controls="settingsView" aria-expanded="false">&#x2699;</button>
      <span class="tufte-top-host-badge" id="tufteTopHostBadge">Antigravity &middot; Auto</span>
      <button class="icon-btn" onclick="window.location.reload()" title="Reload panel" aria-label="Reload panel"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 1 1-1.35-3.6"/><path d="M13.5 2.5v3h-3"/></svg></button>
    </div>
  </div>

  <div id="tsConversationBar" class="ts-conv-bar" role="region" aria-label="Active conversation">
    <span class="ts-conv-label">Chat</span>
    <select id="tsSessionSelect" class="ts-conv-select" aria-label="Select conversation to inspect" title="Follows your active conversation automatically, or pick any recent conversation to inspect its context.">
      <option value="auto">Auto (Following active chat)</option>
    </select>
    <button type="button" id="tsBtnFollowActive" class="ts-conv-btn" hidden title="Pinned to a specific chat. Click to return to automatic active-chat tracking.">Auto</button>
    <button type="button" id="tsBtnJumpChat" class="ts-conv-btn" hidden title="Switch IDE chat pane to this conversation (Alt+Click opens local brain folder).">Open</button>
  </div>

  <div id="tsModeBar" class="ts-mode-bar" role="region" aria-label="Protection mode">
    <div class="ts-mode-meta" data-tip title="Choose how actively Highbeam steps in during your coding session: Off = watch only, Coach = trims noisy logs & gives advice, Auto = hands-free guards & routing.">
      <span class="ts-mode-title">Mode</span>
      <span id="tsModeHint" class="ts-mode-hint">Advises &amp; trims noisy logs</span>
    </div>
    <div id="tsModeSlider" class="ts-mode-slider" role="radiogroup" aria-label="Highbeam protection mode" data-active-mode="coach">
      <span class="ts-mode-thumb" aria-hidden="true"></span>
      <button type="button" role="radio" id="tsModeBtnOff" class="ts-mode-btn" data-mode="off" aria-checked="false" title="Off (Watch only): passively tracks your context glass, cache timer, and savings without blocking commands or injecting advice.">Off</button>
      <button type="button" role="radio" id="tsModeBtnCoach" class="ts-mode-btn" data-mode="coach" aria-checked="true" title="Coach (Recommended): trims noisy command logs in the background and advises you before risky edits or costly model switches.">Coach</button>
      <button type="button" role="radio" id="tsModeBtnAuto" class="ts-mode-btn" data-mode="autopilot" aria-checked="false" title="Auto (Hands-free): enforces active safety guards, large-file read limits, and turn-boundary model/effort routing automatically.">Auto</button>
    </div>
  </div>

  <div id="tsShadowAutoBanner" class="ts-shadow-auto-card" hidden role="region" aria-label="Auto mode status and missed savings">
    <div id="tsShadowAutoHeadline" class="ts-shadow-auto-title">Try hands-free Auto protection for 14 days</div>
    <div id="tsShadowAutoSubline" class="ts-shadow-auto-sub">Hands-free cache holds and loop protection start immediately during your 14-day local trial.</div>
    <div class="ts-shadow-auto-form">
      <input id="tsShadowKeyInput" type="text" class="ts-shadow-key-input" placeholder="CTXP1.eyJ..." aria-label="Highbeam Pro license key">
      <button type="button" id="tsShadowBtnActivate" class="ts-shadow-btn ts-shadow-btn-primary">Unlock Pro</button>
      <button type="button" id="tsShadowBtnTrial" class="ts-shadow-btn">Start 14d Free Trial</button>
      <button type="button" id="tsShadowBtnDismiss" class="ts-shadow-btn">Keep previewing</button>
    </div>
    <div id="tsShadowAutoStatus" class="ts-shadow-auto-sub" hidden></div>
  </div>

  <!-- =========================================================================
       LIVE EDWARD TUFTE "SIMPLE VIEW" SURFACE (4-Card Sketch Layout)
       ========================================================================= -->
  <!-- SETTINGS VIEW: opened from the header gear (or the gear in Advanced); closing returns to the view underneath. -->
  <div id="settingsView" class="settings-view" role="dialog" aria-modal="true" aria-labelledby="settingsViewTitle" hidden>
    <div class="settings-view-head">
      <h2 id="settingsViewTitle">Settings</h2>
      <button type="button" class="icon-btn" id="btnSettingsClose" aria-label="Close settings" title="Close">&#x2715;</button>
    </div>

    <section class="settings-section" aria-labelledby="setModeHead">
      <h3 id="setModeHead">Mode</h3>
      <div id="setModeGroup" class="settings-mode-group" role="radiogroup" aria-label="Highbeam protection mode">
        <button type="button" role="radio" class="set-mode-btn" data-mode="off" aria-checked="false">Off</button>
        <button type="button" role="radio" class="set-mode-btn" data-mode="coach" aria-checked="true">Coach</button>
        <button type="button" role="radio" class="set-mode-btn" data-mode="autopilot" aria-checked="false">Auto</button>
      </div>
      <p class="settings-help">Off watches only. Coach trims noisy logs and gives advice. Auto applies the guards and routing for you (Pro or trial).</p>
    </section>

    <section class="settings-section" aria-labelledby="setLimitsHead">
      <h3 id="setLimitsHead">Limits</h3>
      <form id="settingsPop" class="settings-form">
        <label>Safe limit (tokens)
          <input type="number" id="setSafeLimit" min="20000" max="1048576" step="1000" required>
        </label>
        <label>Remind me at (% of limit)
          <input type="number" id="setReminderPct" min="50" max="99" step="1" required>
        </label>
        <div class="settings-row">
          <button type="submit" class="settings-save">Save</button>
          <button type="button" class="settings-cancel" id="btnSettingsCancel">Close</button>
          <span class="settings-msg" id="settingsMsg"></span>
        </div>
      </form>
    </section>

    <section class="settings-section" aria-labelledby="setLicenceHead">
      <h3 id="setLicenceHead">Licence</h3>
      <p id="setLicenceStatus" class="settings-help">Free</p>
      <div class="settings-row">
        <button type="button" class="settings-save" id="setBtnTrial">Start 14-day trial</button>
      </div>
      <div class="settings-row">
        <input id="setLicenceKey" type="text" class="ts-shadow-key-input" placeholder="CTXP1.eyJ..." aria-label="Highbeam Pro license key">
        <button type="button" class="settings-save" id="setBtnActivate">Activate key</button>
      </div>
      <p id="setLicenceMsg" class="settings-msg" role="status"></p>
    </section>

    <section class="settings-section" aria-labelledby="setGuardsHead">
      <h3 id="setGuardsHead">Guards</h3>
      <p class="settings-help">Read-only here. To change one, run <code>npx highbeam-cli config set &lt;DET-id&gt; &lt;default|off|warn|block&gt;</code>.</p>
      <ul id="setGuardList" class="ts-ledger" role="list"></ul>
    </section>

    <section class="settings-section" aria-labelledby="setAboutHead">
      <h3 id="setAboutHead">About</h3>
      <ul class="settings-about">
        <li>Version: <span id="setAboutVersion">unknown</span></li>
        <li>Project config: <code>.attention-horizon.json</code> &middot; User config: <code>~/.attention-horizon/config.json</code></li>
        <li>Health check: <code>npx highbeam-cli doctor</code></li>
        <li>Docs: <a href="https://gizzant.github.io/context-horizon/" target="_blank" rel="noopener noreferrer">Highbeam User Guide</a></li>
      </ul>
    </section>
  </div>

  <div id="argonSimpleSurface" aria-label="Highbeam main view">
    <!-- MODE VIEWS: the same panel shows the view for the running mode (Off, Coach, Auto). -->
    <section id="tsSavedHero" class="ts-saved-hero" aria-label="Estimated tokens saved">
      <span class="ts-saved-hero-label">Est. tokens saved</span>
      <span class="ts-saved-hero-row">
        <strong id="tsHeroSaved" class="ts-saved-hero-num">+0</strong>
        <span id="tsHeroUsd" class="ts-saved-hero-usd">~$0.00</span>
      </span>
      <span id="tsHeroSub" class="ts-saved-hero-sub">This chat &middot; nothing saved yet</span>
    </section>

    <p id="tsOffNote" class="ts-mode-note mode-only-off" role="status">Watching only. Highbeam tracks context and the cache timer but does not trim logs or give advice. Switch to Coach for advice.</p>

    <div id="tsStatusStrip" class="ts-status-strip mode-hide-off" role="status" aria-live="polite" data-tone="nominal">
      <span id="tsStripDot" class="ts-dot" data-tone="nominal"></span>
      <span id="tsStripText">Healthy</span>
    </div>

    <section id="tsNeedsRow" class="ts-needs-row mode-only-auto" data-tone="ok" role="status" aria-live="polite">
      <span id="tsNeedsTag" class="ts-tag">NEEDS YOU</span>
      <span id="tsNeedsText">Nothing needed from you.</span>
    </section>

    <!-- CARD 1: CONTEXT (scrollTop: 0) + Upper-Right Reversed "Glass of Water" Bar -->
    <section id="tsMetricHeader" class="ts-card ts-metric-header mode-hide-coach mode-hide-auto" aria-label="Context usage and categories">
      <div class="ts-card-head">
        <span class="ts-card-title" data-tip title="How full your AI's working memory is right now compared to the safe limit where it stays accurate and remembers early project rules.">CONTEXT</span>
        <div class="ts-status-badge" role="status" aria-live="polite" data-tip title="Current memory and prompt-cache health. Green or neutral means you have room to work cleanly; amber or red means it is time to compact or slow down.">
          <span id="tsStatusDot" class="ts-dot" data-tone="nominal"></span>
          <span id="tsStatusLabel">Healthy</span>
        </div>
      </div>

      <p id="tsContextSummary" class="ts-explain" data-tip title="A quick look at what is in your AI's working memory now, and how much room is left before older rules get crowded out.">Working memory has plenty of room for edits and multi-file tasks without losing earlier instructions.</p>

      <div class="ts-context-split">
        <div class="ts-context-info">
          <div class="ts-quant-row">
            <span class="ts-quant-primary" data-tip title="Tokens currently in working memory compared to the safe attention ceiling. Staying under this limit prevents the AI from overlooking instructions in the middle or start of chat.">
              <strong id="tsUsedLabel">0.0k</strong> / <span id="tsSafeLabel">179.0k</span> safe (<span id="tsUsedPct">0%</span>)
            </span>
            <span id="tsRunwayMeta" class="ts-runway-meta" data-tone="nominal" data-tip title="Estimated room left before reaching the safe context limit, based on your recent turn size.">179.0k headroom</span>
          </div>

          <div class="ts-cat-list" role="list" aria-label="Context breakdown from newest to oldest">
            <div class="ts-cat-row" id="tsRowNew" role="listitem" data-tip title="Your newest prompts, current code edits, and active working files sitting at the top of the glass.">
              <span class="ts-swatch-dot" style="background:var(--ts-new);" aria-hidden="true"></span>
              <div class="ts-cat-meta">
                <span class="ts-cat-name">New &amp; active</span>
                <span class="ts-cat-sub" id="tsNewSub">Current files &amp; replies</span>
              </div>
              <strong id="tsValNew" class="ts-cat-val">0.0k</strong>
            </div>

            <div class="ts-cat-row" id="tsRowOld" role="listitem" data-tip title="Older conversation turns, repeat full-file reads, resolved error logs, and unrelated memory items that /compact can safely trim away.">
              <span id="tsClutterDot" class="ts-swatch-dot" style="background:var(--ts-clu);" aria-hidden="true"></span>
              <div class="ts-cat-meta">
                <span id="tsClutterKind" class="ts-cat-name">Reclaimable</span>
                <span class="ts-cat-sub" id="tsOldSub">Older chat &amp; repeat reads</span>
              </div>
              <strong id="tsValClutter" class="ts-cat-val">0.0k</strong>
            </div>

            <div class="ts-cat-row" id="tsRowPinned" role="listitem" data-tip title="Foundational project rules (AGENTS.md / CLAUDE.md), learned session rules, and connected tool definitions loaded at the start of the chat (base of the glass).">
              <span class="ts-swatch-dot" style="background:var(--ts-pinned);" aria-hidden="true"></span>
              <div class="ts-cat-meta">
                <span class="ts-cat-name">Rules &amp; tools</span>
                <span id="tsAnchorHealth" class="ts-anchor-health" data-risk="false" title="Whether your pinned startup rules are safely inside the safe memory window or at risk of being pushed out.">Pinned rules safe</span>
              </div>
              <strong id="tsValPinned" class="ts-cat-val">0.0k</strong>
            </div>
          </div>

          <!-- Hidden DOM/screen-reader parity elements preserved for automated accessibility & test checks -->
          <div class="sr-only-metrics" aria-hidden="true">
            <span id="tsValSignal">0.0k</span>
            <div class="ts-bar-wrap">
              <div class="ts-bar-track">
                <div id="tsBarSignal" class="ts-seg-signal" style="width:0%"><span id="tsBarSignalLabel" class="ts-seg-label"></span></div>
                <div id="tsBarClutter" class="ts-seg-clutter" data-clutter-tone="stale" style="width:0%"><span id="tsBarClutterLabel" class="ts-seg-label"></span></div>
              </div>
              <div id="tsSafeTick" class="ts-safe-tick" style="left:70%"></div>
              <div id="tsSafeTickLabel" class="ts-safe-label" style="left:70%">safe limit</div>
              <div id="tsBarOuterLabel" class="ts-bar-outer-label" hidden></div>
            </div>
          </div>
        </div>

        <div class="ts-glass-col">
          <div id="tsGlassVessel" class="ts-glass-vessel" role="img" aria-label="Vertical context fill gauge from pinned rules at bottom to new active work on top" data-state="nominal" data-tip title="Fills bottom-to-top up to your safe limit: pinned Rules & tools sit at the base, Older & reclaimable clutter in the middle, and New & active work on top. Empty space is free headroom.">
            <span id="tsGlassHeadroom" class="ts-glass-headroom-label">100% free</span>
            <div id="tsGlassSafeLine" class="ts-glass-safe-line" hidden title="Safe limit line â€” context above this dashed line risks slowing down or forgetting early rules."></div>
            <div id="tsGlassFill" class="ts-glass-fill" data-empty="true" style="height:0%">
              <div id="tsGlassSegNew" class="ts-glass-seg ts-glass-seg-new" style="height:0%" title="New & active work (recent chat & current files): 0.0k"><span id="tsGlassTagNew" class="ts-glass-seg-tag" hidden>NEW</span></div>
              <div id="tsGlassSegOld" class="ts-glass-seg ts-glass-seg-old" data-clutter-tone="stale" style="height:0%" title="Older & reclaimable clutter (old turns, repeat reads & fixed errors): 0.0k"><span id="tsGlassTagOld" class="ts-glass-seg-tag" hidden>OLD</span></div>
              <div id="tsGlassSegPinned" class="ts-glass-seg ts-glass-seg-pinned" style="height:0%" title="Rules & tools (AGENTS.md / CLAUDE.md, MCP tool lists): 0.0k"><span id="tsGlassTagPinned" class="ts-glass-seg-tag" hidden>BASE</span></div>
            </div>
          </div>
          <span id="tsGlassCaption" class="ts-glass-caption" data-state="nominal" data-tip title="Percentage of the safe working memory limit currently filled.">0% of safe</span>
        </div>
      </div>

      <div class="ts-remediation">
        <div id="tsBtnCleanPrimary" class="ts-cta-btn" role="status" data-cta-state="guarded" title="Type /compact in your chat box and press Enter to clear out older clutter while preserving rules and active files.">
          <span id="tsBtnCleanLabel">Memory is clean &middot; no /compact needed</span>
        </div>
        <div class="ts-compact-caption">
          <span id="tsCompactReclaim" title="How many tokens of older history, duplicate reads, or old errors can be reclaimed without touching your active code.">0.0k reclaimable clutter &middot; Active working set protected</span>
          <span id="tsCompactInstruction" title="Paste the copied /compact command into your AI chat box and press Enter.">Type <code>/compact</code> in chat &amp; press Enter</span>
        </div>
      </div>

      <details id="tsWhyClears" class="ts-why" hidden>
        <summary title="Click to preview exactly which old turns, duplicate file reads, or resolved error logs /compact will remove."><span title="See what gets cleaned up without touching your project rules or current code."><span class="ts-why-caret" aria-hidden="true">&#x25B8;</span>What <code>/compact</code> clears</span><span id="tsWhyTotal" class="ts-why-total">0.0k</span></summary>
        <ul id="tsWhyList" class="ts-why-list" role="list"></ul>
        <div id="tsWhyKeepNote" class="ts-why-keep">Keeps project rules, <code>task.md</code>, your plan, and active code.</div>
      </details>
    </section>

    <!-- CARD 2: DIRECT GUIDANCE -->
    <section id="tsGuidanceSection" class="ts-card mode-hide-off mode-hide-auto" aria-label="Direct guidance">
      <div class="ts-card-head">
        <span class="ts-card-title" data-tip title="Actionable next steps and warnings based on your current memory fill, cache warmth, active guards, and rule health.">DIRECT GUIDANCE</span>
        <span id="tsGuidanceBadge" class="ts-meta" data-tone="muted" data-tip title="Shows whether switching your AI model or reasoning effort right now is free (OK) or will force a costly cache rebuild (Hold).">Model: OK &middot; Effort: OK</span>
      </div>

      <div id="tsDoRow" class="ts-guidance-row" data-tone="do" title="Recommended best next step for your current session state.">
        <span class="ts-tag">DO</span>
        <span id="tsDoText">Safe to run multi-file edits or implementation tasks; working memory has plenty of room for clean work.</span>
      </div>

      <div id="tsAvoidRow" class="ts-guidance-row" data-tone="avoid" title="What to avoid right now so you do not waste quota, lose prompt-cache savings, or confuse the model.">
        <span class="ts-tag">AVOID</span>
        <span id="tsAvoidText">Avoid reading large files without StartLine/EndLine bounds so unneeded lines do not crowd working memory.</span>
      </div>

      <details id="tsSwitchDetailsDrawer" class="ts-drawer">
        <summary title="Expand to see exact Model and Effort switching rules, warm cache hold countdowns, and last model switch impact."><span><span class="ts-why-caret" aria-hidden="true">&#x25B8;</span>Model &amp; effort switching <span id="tsSwitchActiveSummary" class="ts-kpi-sub">Auto &middot; Auto</span></span><span id="tsSwitchDrawerHint" class="ts-kpi-sub">Details</span></summary>
        <div class="ts-drawer-body">
          <div class="ts-switch-grid">
            <div id="tsModelCard" class="ts-guidance-row ts-switch-card" data-tone="do" title="Whether changing your AI model mid-chat will invalidate your discounted prompt cache.">
              <div class="ts-switch-head"><span class="ts-tag">MODEL</span><span id="tsModelVerdict" class="ts-switch-verdict">OK</span></div>
              <div id="tsModelName" class="ts-switch-name">Auto</div>
              <ul class="ts-switch-lines">
                <li id="tsModelSameFam">Cache is cold &mdash; switching within the same model family adds no rewrite cost.</li>
                <li id="tsModelCrossFam"></li>
              </ul>
              <div id="tsModelLast" class="ts-sub" hidden></div>
            </div>
            <div id="tsEffortCard" class="ts-guidance-row ts-switch-card" data-tone="do" title="Whether changing reasoning effort level right now breaks your cached chat history.">
              <div class="ts-switch-head"><span class="ts-tag">EFFORT</span><span id="tsEffortVerdict" class="ts-switch-verdict">OK</span></div>
              <div id="tsEffortName" class="ts-switch-name">Auto</div>
              <div id="tsEffortText" class="ts-sub">Match effort to the task: Low or Medium keeps edits fast, and High helps on tricky specs or bugs.</div>
              <div id="tsEffortHist" class="ts-sub" hidden></div>
            </div>
          </div>
        </div>
      </details>
    </section>

    <!-- CARD 3: AUTOMATED ACTIVITY -->
    <section id="tsActivitySection" class="ts-card mode-hide-off mode-hide-coach" aria-label="Automated activity">
      <div class="ts-card-head">
        <span class="ts-card-title" data-tip title="What Highbeam does in the background: it trims long test logs, skips repeat file reads, protects your warm cache, and applies learned rules.">AUTOMATED ACTIVITY</span>
        <span id="tsGuardsSummary" class="ts-kpi-sub" data-tip title="Number of background interventions active in this chat and how many safety/efficiency guards are currently armed.">Guards armed</span>
      </div>

      <ul id="tsLedgerList" class="ts-ledger" role="list">
        <li class="ts-ledger-row" title="Highbeam watches tool outputs and rule writes locally so noisy logs and premature rule edits do not bloat memory or break warm caches.">
          <span class="ts-ledger-age">now</span>
          <span>Guards armed â€” trimming long command output and protecting your warm prompt cache</span>
          <span class="ts-ledger-saved">ready</span>
        </li>
      </ul>

      <details id="tsLearnedRulesDrawer" class="ts-drawer mode-hide-off mode-hide-coach mode-hide-auto" hidden>
        <summary title="Click to see the project rules and recovery steps Highbeam learned from your earlier coding sessions."><span><span class="ts-why-caret" aria-hidden="true">&#x25B8;</span><span id="tsLearnedRulesSummary">Applying learned rules</span></span><span id="tsLearnedRulesHint" class="ts-kpi-sub">Details</span></summary>
        <div id="tsLearnedRulesHead" class="ts-guard-head" hidden>Learned project rules</div>
        <ul id="tsLearnedRulesList" class="ts-ledger ts-guard-list" role="list" hidden></ul>
      </details>

      <details id="tsActivityDrawer" class="ts-drawer mode-hide-off mode-hide-coach mode-hide-auto">
        <summary title="Click to see every guard, whether it needs attention now, and whether it blocks bad actions or only gives advice."><span><span class="ts-why-caret" aria-hidden="true">&#x25B8;</span>Active safety &amp; efficiency guards</span><span id="tsGuardRosterHint" class="ts-kpi-sub">Details</span></summary>
        <div id="tsGuardListHead" class="ts-guard-head" hidden>Live guards</div>
        <ul id="tsGuardList" class="ts-ledger ts-guard-list" role="list" hidden></ul>
      </details>
    </section>

    <!-- CARD 4: SESSION OVERVIEW -->
    <section id="tsSessionSection" class="ts-card mode-hide-coach mode-hide-auto" aria-label="Session overview">
      <div class="ts-card-head">
        <span class="ts-card-title" data-tip title="A big-picture look at your entire chat session from Turn 1 until now: how fast context is growing, how well the prompt cache is sticking, and total savings.">SESSION OVERVIEW</span>
        <span id="tsSessionTurnsMeta" class="ts-kpi-sub" data-tip title="Total turns recorded in this conversation so far, along with how many stayed lean vs. triggered a spike or warning.">Session start</span>
      </div>

      <p id="tsSessionDigest" class="ts-explain" data-tip title="A short summary of how this chat is going, including /compact runs, checkpoints, and cache use.">Tracking your session from Turn 1 &mdash; watching context growth, prompt cache reuse, and token savings.</p>

      <div class="ts-metric-list" role="region" aria-label="Entire session metrics">
        <!-- Row 1: Entire Session Pace & Velocity Sparkline -->
        <div class="ts-metric-row" title="Shows how quickly context is growing per turn and highlights key milestones like /compact runs, checkpoints, or model switches.">
          <div class="ts-metric-main">
            <span class="ts-metric-label">Session pace</span>
            <span id="tsSessionPaceMeta" class="ts-meta" data-tone="muted">Steady</span>
          </div>
          <svg id="tsTurnSparkline" class="ts-sparkline" width="72" height="18" viewBox="0 0 72 18" role="img" aria-label="Per-turn context velocity sparkline">
            <title id="tsSparklineTip">Per-turn context size trend across this chat (left = earlier turns, right = latest turn).</title>
            <polyline id="tsSparklinePath" fill="none" stroke="var(--text-secondary)" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" points="1,15 71,15"/>
            <circle id="tsSparklineDot" cx="71" cy="15" r="2" fill="var(--text-primary)"/>
          </svg>
        </div>

        <!-- Row 2: Prompt Cache Hit Rate, Retention & TTL -> 1D BulletBar -->
        <div class="ts-metric-row" title="Warm prompt cache reuses earlier conversation turns at a 90%â€“95% discount until the timer runs out or the start of the chat changes. Target line sits at 80%.">
          <div class="ts-metric-main">
            <span class="ts-metric-label">Prompt cache</span>
            <span id="tsCacheMeta" class="ts-meta" data-tone="muted">0% hit &middot; Cold</span>
            <span id="tsRetentionMeta" class="ts-kpi-sub" hidden></span>
          </div>
          <div class="ts-micro-bullet" role="img" aria-label="Prompt cache hit rate against 80% target" title="Current prompt cache hit rate compared against the 80% target tick mark.">
            <div id="tsCacheBulletFill" class="ts-micro-bullet-fill" style="width:0%"></div>
            <div class="ts-micro-bullet-tick" title="80% cache hit target"></div>
          </div>
        </div>

        <!-- Row 3: Estimated Savings & 5h Quota Pacing -->
        <div class="ts-metric-row" title="Tokens and estimated spend saved locally by trimming verbose logs, skipping duplicate reads, and keeping your prompt cache warm.">
          <div class="ts-metric-main">
            <span class="ts-metric-label">Saved</span>
            <span id="tsKpiSaved" class="ts-kpi-inline" title="Estimated tokens saved during this active chat session.">+0.0k</span>
            <span id="tsKpiUsd" class="ts-kpi-sub" title="Estimated input cost avoided in this chat based on your active model rate.">~$0.00</span>
            <span class="ts-kpi-sub" aria-hidden="true">&middot;</span>
            <span id="tsKpi30d" class="ts-kpi-sub" title="Cumulative estimated savings across this workspace over the last 30 days.">30d: +0.0k (~$0.00)</span>
            <span id="tsSprintMeta" class="ts-kpi-sub" hidden title="Estimated share of your 5-hour rolling seat quota used so far."></span>
          </div>
          <span id="tsSavedHint" class="ts-kpi-sub" title="All savings are counted once per turn from Highbeam's local ledger with zero estimates padded in.">estimated</span>
        </div>

        <!-- Row 4 (Conditional): v4.1 Multi-Agent Swarm, Learned Rules & Sharded Constraints -->
        <div id="tsSessionExtraRow" class="ts-metric-row" hidden>
          <div class="ts-metric-main">
            <span class="ts-metric-label">Workspace state</span>
            <span id="tsSessionExtraText" class="ts-kpi-sub"></span>
          </div>
        </div>

        <!-- Row 5 (Conditional): Option A Shadow Auto Preview for Free / Expired Trial -->
        <div id="tsShadowAutoRow" class="ts-metric-row" hidden title="Problems that Auto mode would have fixed for you if it were turned on.">
          <div class="ts-metric-main">
            <span class="ts-metric-label">Auto preview</span>
            <span id="tsShadowAutoMeta" class="ts-kpi-sub"></span>
          </div>
        </div>
      </div>
    </section>
  </div>
