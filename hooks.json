        "type": "command",
        "command": "node --no-warnings -e \"import('node:fs').then(fs=>import('node:os').then(os=>import('node:path').then(p=>{const f1=p.join(os.homedir(),'.gemini/config/plugins/agy-horizon-flightcheck/src/hooks/post_invocation.mjs');const f2=p.join(os.homedir(),'.gemini/config/plugins/agy-horizon/src/hooks/post_invocation.mjs');const target=fs.existsSync(f1)?f1:(fs.existsSync(f2)?f2:'');if(target)import(process.platform==='win32'?'file:///'+target.replace(/\\\\/g,'/'):target);})));\"",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|read_file|view_file|invoke_subagent|define_subagent|send_message|manage_subagents",
        "type": "command",
        "command": "node --no-warnings -e \"import('node:fs').then(fs=>import('node:os').then(os=>import('node:path').then(p=>{const f1=p.join(os.homedir(),'.gemini/config/plugins/agy-horizon-flightcheck/src/hooks/pre_invocation.mjs');const f2=p.join(os.homedir(),'.gemini/config/plugins/agy-horizon/src/hooks/pre_invocation.mjs');const target=fs.existsSync(f1)?f1:(fs.existsSync(f2)?f2:'');if(target)import(process.platform==='win32'?'file:///'+target.replace(/\\\\/g,'/'):target);})));\"",
        "timeout": 5
