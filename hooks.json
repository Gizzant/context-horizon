{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session_start.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre_invocation.mjs",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/post_invocation.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content|read_file|view_file|grep_search|find_by_name|list_dir|invoke_subagent|define_subagent|send_message|manage_subagents|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre_tool_use.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content|read_file|view_file|grep_search|find_by_name|list_dir|invoke_subagent|define_subagent|send_message|manage_subagents|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post_tool_use.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
