{
  "name": "highbeam-cli",
  "displayName": "Highbeam",
  "version": "4.2.2",
  "description": "Highbeam v4.2: Local context window profiler, warm KV-cache guard, and token-efficiency CLI for Google Antigravity, Claude Code, and MCP hosts.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/engine-node",
    "packages/antigravity",
    "packages/claude-code",
    "packages/pro",
    "packages/mcp"
  ],
  "bin": {
    "highbeam": "bin/ctxtop.mjs",
    "highbeam-cli": "bin/ctxtop.mjs",
    "highbeam-mcp": "packages/mcp/src/server.mjs",
    "ah": "bin/ctxtop.mjs",
    "attention-horizon": "bin/ctxtop.mjs",
    "ctxtop": "bin/ctxtop.mjs",
    "ah-statusline": "bin/ah-statusline.mjs",
    "attention-horizon-antigravity": "src/cli/init.mjs",
    "ah-antigravity": "src/cli/init.mjs",
    "attention-horizon-claude": "bin/ctxtop.mjs",
    "ah-claude": "bin/ctxtop.mjs",
    "agy-horizon": "src/cli/init.mjs",
    "agy-horizon-flightcheck": "src/cli/init.mjs",
    "agy-log-search": "bin/ctxtop.mjs",
    "ah-mcp": "packages/mcp/src/server.mjs",
    "ctxtop-mcp": "packages/mcp/src/server.mjs"
  },
  "main": "./src/cli/horizon_hud.mjs",
  "files": [
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHECKSUMS.sha256",
    "plugin.json",
    "smithery.yaml",
    "glama.json",
    "server.json",
    ".antigravity-plugin/",
    ".claude-plugin/",
    "hooks.json",
    "hooks/",
    "bin/",
    "commands/",
    "agents/",
    "config/",
    "assets/logo.svg",
    "rules/",
    "skills/",
    "sidecars/",
    "packages/pro/",
    "!packages/pro/workers/**",
    "!packages/pro/wrangler.toml",
    "!packages/pro/README-SIGNING.md",
    "packages/mcp/",
    "!packages/mcp/src/vendor/**",
    "src/",
    "!src/webview/partials/**",
    "!src/webview/.npmignore"
  ],
  "scripts": {
    "start": "node --no-warnings src/cli/init.mjs --demo",
    "demo": "node --no-warnings src/cli/init.mjs --demo-animate",
    "dev": "node --no-warnings src/cli/init.mjs --serve",
    "hud": "node --no-warnings src/cli/horizon_hud.mjs --demo",
    "roast": "node --no-warnings src/cli/init.mjs --roast",
    "postmortem": "node --no-warnings src/cli/init.mjs postmortem",
    "doctor": "node --no-warnings src/cli/init.mjs doctor",
    "install-plugin": "node --no-warnings src/cli/init.mjs init",
    "build:bundles": "node scripts/build_evaluation_bundles.mjs",
    "build:assets": "node --no-warnings scripts/generate_hero_svg.mjs && node --no-warnings scripts/build_demo_page.mjs",
    "build:release": "node scripts/build_release_bundle.mjs",
    "build:vsix": "node scripts/build_vsix.mjs",
    "test": "npm run test:unit && npm run test:coach && npm run test:gates && npm run test:phases",
    "test:unit": "node --import ./test/setup/isolate-home.mjs --test tests/test_router_and_sensors.mjs tests/test_wave1_wedge.mjs tests/test_wave2_wedge.mjs tests/test_wave3_wedge.mjs tests/test_carbon_swarm_patch.mjs tests/test_concurrency.mjs tests/test_postmortem_features.mjs tests/test_schema_drift.mjs tests/test_mirror_boot_smoke.mjs && node --import ./test/setup/isolate-home.mjs tests/test_regressions.cjs",
    "test:coach": "node --import ./test/setup/isolate-home.mjs --test test/all.test.mjs",
    "test:claude": "node --import ./test/setup/isolate-home.mjs --test test/claude-code/*.test.mjs",
    "test:gates": "node --import ./test/setup/isolate-home.mjs --test tests/verify_gate_0.mjs tests/verify_gate_1.mjs tests/verify_gate_2.mjs tests/verify_gate_3.mjs tests/verify_gate_4.mjs tests/verify_gate_5.mjs tests/verify_gate_6.mjs",
    "test:phases": "node --import ./test/setup/isolate-home.mjs tests/verify_phase_1.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_2.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_3.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_4.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_5.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_6.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_6_roadmap.mjs && node --import ./test/setup/isolate-home.mjs tests/verify_phase_7.mjs",
    "test:e2e": "node --import ./test/setup/isolate-home.mjs tests/verify_e2e_context_memory.mjs",
    "bench": "node --import ./test/setup/isolate-home.mjs tests/bench_latency.mjs",
    "bench:scenario": "node --no-warnings tests/benchmark_context_scenario.mjs",
    "bench:composite": "node scripts/run_composite_benchmarks.mjs",
    "bench:bucket-b": "node scripts/run_bucket_b_harness.mjs",
    "bench:parity": "node scripts/run_antigravity_and_compression_benchmark.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gizzant/context-horizon.git"
  },
  "homepage": "https://gizzant.github.io/context-horizon/",
  "bugs": {
    "url": "https://github.com/Gizzant/context-horizon/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai-agents",
    "context-window",
    "llm-telemetry",
    "antigravity",
    "google-antigravity",
    "mcp",
    "sludge-tax",
    "attention-horizon",
    "highbeam",
    "highbeam-cli",
    "ctxtop",
    "developer-tools",
    "tufte",
    "cli"
  ],
  "author": "Gizzant <security@highbeamdev.com>",
  "license": "SEE LICENSE IN LICENSE",
  "commercialLicense": "SEE LICENSE IN packages/pro/LICENSE-COMMERCIAL.md",
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
